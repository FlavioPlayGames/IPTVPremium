+package br.com.flaviotorres.iptvpremium.core.storage
+
+import android.content.Context
+
+/** Durable one-shot request: cache cleanup/restart must refresh only the playlist selected by the user. */
+internal class ActivePlaylistRefresh(context:Context) {
+    private val preferences=context.applicationContext.getSharedPreferences("active_playlist_refresh",Context.MODE_PRIVATE)
+    fun pendingPlaylistId():String?=preferences.getString("playlist",null)?.takeIf {it.isNotBlank()}
+    fun request(playlistId:String):Boolean {
+        val id=playlistId.trim()
+        if(id.isEmpty())return false
+        return preferences.edit().clear().putString("playlist",id).commit()
+    }
+    fun needsSync(playlistId:String,activeGeneration:String?):Boolean =
+        pendingPlaylistId()==playlistId &&
+            (activeGeneration.isNullOrBlank() || preferences.getString("imported_generation",null)!=activeGeneration)
+    fun markImported(playlistId:String,generation:String):Boolean {
+        if(pendingPlaylistId()!=playlistId || generation.isBlank())return false
+        return preferences.edit().putString("imported_generation",generation).commit()
+    }
+    fun complete(playlistId:String):Boolean {
+        if(pendingPlaylistId()!=playlistId)return false
+        return preferences.edit().clear().commit()
+    }
+}
