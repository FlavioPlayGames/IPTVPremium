+package br.com.flaviotorres.iptvpremium.data.cache
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+@org.junit.runner.RunWith(androidx.test.ext.junit.runners.AndroidJUnit4::class)
+class PosterDownloadUrlDeviceTest {
+    @Test fun originalAndLargeSizesUse342() {
+        for (size in listOf("original", "w500", "w780")) {
+            assertEquals("https://image.tmdb.org/t/p/w342/poster.jpg", PosterDownloadUrl.optimized("https://image.tmdb.org/t/p/$size/poster.jpg"))
+        }
+    }
+    @Test fun smallerImagesAreNeverIncreased() {
+        for (size in listOf("w92", "w154", "w185", "w342")) {
+            val url="https://image.tmdb.org/t/p/$size/poster.jpg"
+            assertEquals(url,PosterDownloadUrl.optimized(url))
+        }
+    }
+    @Test fun providerLinksAndSimilarDomainsStayIntact() {
+        for (url in listOf("https://provider.example/t/p/original/poster.jpg", "https://image.tmdb.org.evil.example/t/p/original/poster.jpg", "https://image.tmdb.org@provider.example/t/p/original/poster.jpg", "https://provider.example/poster.jpg?source=https://image.tmdb.org/t/p/original/x.jpg")) {
+            assertEquals(url,PosterDownloadUrl.optimized(url))
+        }
+    }
+    @Test fun queryAndEscapedFilenameArePreserved() {
+        assertEquals("https://image.tmdb.org/t/p/w342/a%20b.jpg?token=abc%2F123#x",PosterDownloadUrl.optimized("https://image.tmdb.org/t/p/original/a%20b.jpg?token=abc%2F123#x"))
+    }
+    @Test fun malformedAndUnknownPathsStayIntact() {
+        for (url in listOf("not a url", "https://image.tmdb.org/other/original/x.jpg", "https://image.tmdb.org/t/p/w9999999999999999999/x.jpg", "https://image.tmdb.org/t/p/original/sub/x.jpg")) assertEquals(url,PosterDownloadUrl.optimized(url))
+    }
+    @Test fun episodeStillsUse300WithoutChangingRatioOrProviderUrls() {
+        assertEquals("https://image.tmdb.org/t/p/w300/episode.jpg",PosterDownloadUrl.optimized("https://image.tmdb.org/t/p/w780/episode.jpg", width = 300))
+        val small="https://image.tmdb.org/t/p/w185/episode.jpg"
+        assertEquals(small,PosterDownloadUrl.optimized(small, width = 300))
+        val provider="https://provider.example/episode.jpg"
+        assertEquals(provider,PosterDownloadUrl.optimized(provider, width = 300))
+    }
+    @Test fun optimizationIsIdempotentAndKeepsHttp() {
+        val url="http://image.tmdb.org/t/p/w500/x.jpg"
+        val result=PosterDownloadUrl.optimized(url)
+        assertEquals("http://image.tmdb.org/t/p/w342/x.jpg",result)
+        assertEquals(result,PosterDownloadUrl.optimized(result))
+    }
+}
