+package br.com.flaviotorres.iptvpremium.data.cache
+
+import java.net.URI
+
+/** Somente capas do CDN oficial; a chave do cache continua sendo o link da lista. */
+internal object PosterDownloadUrl {
+    fun optimized(raw: String, width: Int = 342): String {
+        if (width != 342 && width != 300) return raw
+        val uri = try { URI(raw) } catch (_: Exception) { return raw }
+        if (!uri.scheme.equals("https", true) && !uri.scheme.equals("http", true)) return raw
+        if (!uri.host.equals("image.tmdb.org", true) || uri.rawUserInfo != null ||
+            uri.port !in listOf(-1, 80, 443)) return raw
+        val path = uri.rawPath ?: return raw
+        val match = Regex("^/t/p/(original|w[0-9]+)/[^/]+$").matchEntire(path) ?: return raw
+        val size = match.groupValues[1]
+        if (size != "original" && (size.drop(1).toIntOrNull() ?: return raw) <= width) return raw
+        val start = raw.indexOf(path, raw.indexOf("://") + 3)
+        if (start < 0) return raw
+        val replacement = path.replaceRange(5, 5 + size.length, "w$width")
+        return raw.replaceRange(start, start + path.length, replacement)
+    }
+}
