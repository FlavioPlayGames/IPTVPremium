+                moveTo(w * .5f, h * .88f)
+                cubicTo(w * .42f, h * .8f, w * .08f, h * .58f, w * .08f, h * .32f)
+                cubicTo(w * .08f, h * .05f, w * .36f, h * .0f, w * .5f, h * .17f)
