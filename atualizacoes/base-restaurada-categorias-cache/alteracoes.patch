+package br.com.flaviotorres.iptvpremium.core.media
+
+import androidx.test.core.app.ApplicationProvider
+import kotlinx.coroutines.runBlocking
+import org.json.JSONArray
+import org.junit.Assert.*
+import org.junit.Test
+
+class RestoredTrailerDeviceTest {
+    @Test fun launcherTargetsInternalPlayerRatherThanAnExternalApp() {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        val intent = trailerIntent(context, TrailerRequest("Minha série", "dubbed12345", "tv", "42", 2020))
+        assertEquals(TrailerPlayerActivity::class.java.name, intent.component?.className)
+        assertEquals(context.packageName, intent.component?.packageName)
+        assertEquals("tv", intent.getStringExtra("kind"))
+        assertEquals("42", intent.getStringExtra("tmdbId"))
+        assertEquals(2020, intent.getIntExtra("year", 0))
+        assertNull(intent.data)
+    }
+    @Test fun portugueseDubbedAndSubtitledTrailersPrecedeEnglish() {
+        val data = JSONArray("""[
+            {"site":"YouTube","key":"english1234","type":"Trailer","official":true,"iso_639_1":"en","name":"Official trailer"},
+            {"site":"YouTube","key":"subtitl1234","type":"Trailer","official":true,"iso_639_1":"pt","name":"Trailer legendado"},
+            {"site":"YouTube","key":"dubbed12345","type":"Trailer","official":true,"iso_639_1":"pt","name":"Trailer dublado"},
+            {"site":"Other","key":"notyoutube1","type":"Trailer"},
+            {"site":"YouTube","key":"bad<script>","type":"Trailer"}
+        ]""")
+        val choices = TrailerResolver { _, _ -> "{}" }.rank(listOf(data))
+        assertEquals(listOf("dubbed12345", "subtitl1234", "english1234"), choices.map { it.youtubeId })
+    }
+    @Test fun tvSearchUsesCorrectEndpointAndYearWithoutAcceptingUnrelatedTitles() = runBlocking {
+        val calls = mutableListOf<Pair<String, Map<String, String>>>()
+        val resolver = TrailerResolver { path, query ->
+            calls.add(path to query)
+            if (path == "/search/tv") """{"results":[{"id":42,"name":"Minha Série"}]}"""
+            else """{"results":[{"site":"YouTube","key":"dubbed12345","type":"Trailer","iso_639_1":"pt"}]}"""
+        }
+        val result = resolver.resolve(TrailerRequest("Minha Série (2020) [L]", kind = "tv", year = 2020))
+        assertEquals("Minha Série", calls.first().second["query"])
+        assertEquals("2020", calls.first().second["first_air_date_year"])
+        assertTrue(calls.drop(1).all { it.first == "/tv/42/videos" })
+        assertEquals(1, result.size)
+    }
+    @Test fun providerTrailerRemainsAvailableWhenMetadataFails() = runBlocking {
+        val result = TrailerResolver { _, _ -> throw java.io.IOException("offline fixture") }
+            .resolve(TrailerRequest("Teste", "https://youtu.be/dubbed12345", tmdbId = "42"))
+        assertEquals("dubbed12345", result.single().youtubeId)
+    }
+    @Test fun numericMovieTitlesAreNotMistakenForReleaseYears() {
+        assertEquals("1917", trailerSearchTitle("1917"))
+        assertEquals("2001 - Uma Odisseia no Espaço", trailerSearchTitle("2001 - Uma Odisseia no Espaço (1968) [L]"))
+    }
+    @Test fun directVideoAndYoutubeInputsAreValidated() {
+        assertEquals("dubbed12345", providerTrailer("dubbed12345")?.youtubeId)
+        assertNotNull(providerTrailer("https://example.invalid/trailer.mp4?signature=fixture"))
+        assertNull(providerTrailer("javascript:alert(1)"))
+        assertNull(providerTrailer("file:///private/trailer.mp4"))
+        assertNull(providerTrailer("https://example.invalid/watch"))
+    }
+    @Test fun embedRequestsPortugueseCaptionsAndKeepsOfficialPlayerControls() {
+        val html = youtubeTrailerHtml("dubbed12345", "https://br.com.flaviotorres.iptvpremium/")
+        assertTrue(html.contains("https://www.youtube.com/iframe_api"))
+        assertTrue(html.contains("cc_lang_pref=pt"))
+        assertTrue(html.contains("cc_load_policy=1"))
+        assertTrue(html.contains("controls=1"))
+        assertTrue(html.contains("<iframe id=\"player\""))
+        assertTrue(html.contains("https://www.youtube.com/embed/dubbed12345"))
+        assertTrue(html.indexOf("function onYouTubeIframeAPIReady") < html.indexOf("api.src="))
+        assertTrue(html.contains("onStateChange"))
+        assertTrue(html.contains("TrailerHost.playing()"))
+        assertTrue(html.contains("onAutoplayBlocked"))
+
+        assertTrue(html.contains("origin=https%3A%2F%2Fbr.com.flaviotorres.iptvpremium"))
+        try { youtubeTrailerHtml("bad<script>", "https://example.invalid/"); fail("Invalid ID") }
+        catch (_: IllegalArgumentException) { }
+    }
+    @Test fun unrelatedSearchResultDoesNotOpenTheWrongTrailer() = runBlocking {
+        var videosRequested = false
+        val choices = TrailerResolver { path, _ ->
+            if (path.contains("/videos")) videosRequested = true
+            """{"results":[{"id":1,"title":"Outro filme"}]}"""
+        }.resolve(TrailerRequest("Filme esperado"))
+        assertTrue(choices.isEmpty())
+        assertFalse(videosRequested)
+    }
+}
