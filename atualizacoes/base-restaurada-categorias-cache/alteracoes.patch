+package br.com.flaviotorres.iptvpremium.data.repository
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.toPixelMap
+import androidx.compose.ui.graphics.asImageBitmap
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.*
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.unit.dp
+import androidx.paging.PagingData
+import androidx.paging.compose.collectAsLazyPagingItems
+import br.com.flaviotorres.iptvpremium.domain.model.Movie
+import br.com.flaviotorres.iptvpremium.domain.model.Series
+import br.com.flaviotorres.iptvpremium.ui.components.CatalogFavoriteHeart
+import br.com.flaviotorres.iptvpremium.ui.movies.MoviesScreen
+import br.com.flaviotorres.iptvpremium.ui.series.SeriesScreen
+import kotlinx.coroutines.flow.flowOf
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+
+class RestoredCatalogEntryDeviceTest {
+    @get:Rule val compose = createComposeRule()
+    @Test fun moviesStartInCategorySelectionAndHeartIsBelowTitle() {
+        val data = flowOf(PagingData.from(List(30) { Movie("m$it", "Filme $it", null, null, null, "", 2026, 8.0, null) }))
+        compose.setContent {
+            val movies = data.collectAsLazyPagingItems()
+            Box(Modifier.requiredSize(960.dp, 540.dp)) { MoviesScreen(pagedMovies = movies, totalMovieCount = 30) }
+        }
+        compose.waitUntil(5_000) { compose.onAllNodesWithTag("movie-category-ALL").filter(isFocused()).fetchSemanticsNodes().isNotEmpty() }
+        compose.onNodeWithTag("movie-category-ALL").assertIsFocused()
+        compose.onNodeWithText("Filme 0").assertExists()
+        val title = compose.onNodeWithText("Filme 0").fetchSemanticsNode().boundsInRoot
+        val heart = compose.onAllNodes(hasStateDescription("Não favorito"), useUnmergedTree = true).onFirst().fetchSemanticsNode().boundsInRoot
+        assertTrue(heart.top >= title.bottom)
+    }
+    @Test fun seriesStartInCategorySelection() {
+        val data = flowOf(PagingData.from(List(30) { Series("s$it", "Série $it", null, null, null, 2026, 8.0, null) }))
+        compose.setContent {
+            val series = data.collectAsLazyPagingItems()
+            Box(Modifier.requiredSize(960.dp, 540.dp)) { SeriesScreen(pagedSeries = series, totalSeriesCount = 30) }
+        }
+        compose.waitUntil(5_000) { compose.onAllNodesWithTag("series-category-ALL").filter(isFocused()).fetchSemanticsNodes().isNotEmpty() }
+        compose.onNodeWithTag("series-category-ALL").assertIsFocused()
+    }
+    @Test fun heartFillsWhenFavoritedAndTogglesWithoutASeparateKeyboardFocus() {
+        val favorite = mutableStateOf(false)
+        lateinit var view: android.view.View
+        compose.setContent {
+            val current = androidx.compose.ui.platform.LocalView.current
+            SideEffect { view = current }
+            Box(Modifier.size(40.dp).background(Color.Black).testTag("heart")) {
+                CatalogFavoriteHeart(favorite.value, compact = false) { favorite.value = !favorite.value }
+            }
+        }
+        repeat(2) {
+            val state = if (favorite.value) "Favorito" else "Não favorito"
+            val node = compose.onNode(hasStateDescription(state), useUnmergedTree = true).fetchSemanticsNode()
+            val full = android.graphics.Bitmap.createBitmap(view.width, view.height, android.graphics.Bitmap.Config.ARGB_8888)
+            compose.runOnIdle { view.draw(android.graphics.Canvas(full)) }
+            val bounds = node.boundsInRoot
+            val pixels = android.graphics.Bitmap.createBitmap(full,
+                bounds.left.toInt(), bounds.top.toInt(), bounds.width.toInt(), bounds.height.toInt()).asImageBitmap().toPixelMap()
+            val center = pixels[pixels.width / 2, pixels.height / 2]
+            assertTrue((0 until pixels.height).sumOf { y ->
+                (0 until pixels.width).count { x -> val color = pixels[x, y]; color.red > .2f || color.green > .2f || color.blue > .2f }
+            } > 0)
+            if (favorite.value) assertTrue(center.red > .2f || center.green > .2f)
+            else assertTrue(center.red < .1f && center.green < .1f && center.blue < .1f)
+            compose.onNode(hasStateDescription(state), useUnmergedTree = true).performClick()
+        }
+        assertFalse(favorite.value)
+    }
+}
