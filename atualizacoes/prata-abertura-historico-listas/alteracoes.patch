+import kotlinx.coroutines.sync.withLock
+
+/** A single bounded local portrait shared by all cards and themes; no network or tinted copies. */
+internal object MissingCastPortraitCache {
+    @Volatile private var image:ImageBitmap?=null
+    private val mutex=Mutex()
+    fun peek()=image
+    suspend fun load(context:Context):ImageBitmap?=withContext(Dispatchers.IO) {
+        mutex.withLock {
+            image?:run {
+                val bounds=BitmapFactory.Options().apply { inJustDecodeBounds=true;inScaled=false }
+                BitmapFactory.decodeResource(context.resources,R.drawable.cast_missing_prata,bounds)
+                var sample=1
+                while(bounds.outWidth/sample>384 && bounds.outHeight/sample>512)sample*=2
+                BitmapFactory.decodeResource(context.resources,R.drawable.cast_missing_prata,
+                    BitmapFactory.Options().apply { inScaled=false;inSampleSize=sample;inPreferredConfig=Bitmap.Config.RGB_565 })
+                    ?.asImageBitmap()?.also {image=it}
+            }
+        }
+    }
+}
+@Composable
+internal fun MissingCastPortrait(name:String,modifier:Modifier=Modifier) {
+    val context=LocalContext.current.applicationContext
+    val image by produceState(MissingCastPortraitCache.peek(),context) {value=MissingCastPortraitCache.load(context)}
+    image?.let {Image(it,"Foto indisponível: $name",modifier,contentScale=ContentScale.Crop)}
+}
