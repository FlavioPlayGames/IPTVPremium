+@Composable
+internal fun KidsScreen(onChannels:()->Unit,onMovies:()->Unit,onSeries:()->Unit,onBack:()->Unit) {
+    val first=remember { FocusRequester() }
+    BackHandler(onBack=onBack)
+    LaunchedEffect(Unit) { withFrameNanos { }; first.requestFocus() }
+    val wide = androidx.compose.ui.platform.LocalConfiguration.current.screenWidthDp >= 700
+    Column(Modifier.fillMaxSize().background(ThemeColors.surface(0xFF080A0C))
+        .onPreviewKeyEvent { if(it.key==Key.Escape) { if(it.type==KeyEventType.KeyUp) onBack();true } else false }
+        .verticalScroll(rememberScrollState()).padding(24.dp),horizontalAlignment=Alignment.CenterHorizontally,verticalArrangement=Arrangement.Center) {
+        KidsLogo(Modifier.height(150.dp).width(180.dp))
+        Text("KIDS",color=ThemeColors.color(0xFFFFE6A0),fontSize=28.sp)
+        Spacer(Modifier.height(24.dp))
+        FlowRow(maxItemsInEachRow = if (wide) 3 else 2, horizontalArrangement=Arrangement.spacedBy(24.dp, Alignment.CenterHorizontally), verticalArrangement=Arrangement.spacedBy(24.dp)) {
+            HomeMenuCard("Canais",onChannels,Modifier.focusRequester(first),R.drawable.home_channels)
+            HomeMenuCard("Filmes",onMovies,imageResId=R.drawable.home_movies)
+            HomeMenuCard("Séries",onSeries,imageResId=R.drawable.home_series)
+        }
+    }
+}
+
+@Composable
+internal fun KidsRouteAllowed(onBack:()->Unit):Boolean {
+    val access by br.com.flaviotorres.iptvpremium.ui.settings.ParentalPolicy.accessFlow.collectAsState(
+        initial=br.com.flaviotorres.iptvpremium.ui.settings.ParentalPolicy.access())
+    if(!access.enabled || !access.rules.kidsOnly || access.kidsCatalog) return true
+    BackHandler(onBack=onBack)
+    Column(Modifier.fillMaxSize().background(ThemeColors.surface(0xFF080A0C)).padding(32.dp),
+        verticalArrangement=Arrangement.Center,horizontalAlignment=Alignment.CenterHorizontally) {
+        Text("Acesso disponível apenas no Kids",color=Color.White,fontSize=22.sp)
+        Spacer(Modifier.height(16.dp))
+        br.com.flaviotorres.iptvpremium.core.device.PortalOutlineButton("Voltar",onClick=onBack)
+    }
+    return false
+}
