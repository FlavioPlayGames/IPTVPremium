+package br.com.flaviotorres.iptvpremium.data.cache
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import java.io.ByteArrayOutputStream
+import java.io.File
+import kotlin.math.roundToInt
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+
+/** Limita somente posters; fundos, logos e fotos mantem a resolucao anterior. */
+internal object PosterResolution {
+    const val WIDTH = 400
+    const val HEIGHT = 600
+    private val conversions = Semaphore(2)
+
+    fun decode(file: File, config: Bitmap.Config = Bitmap.Config.ARGB_8888): Bitmap? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.absolutePath, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        var sample = 1
+        while (bounds.outWidth / (sample * 2) >= WIDTH &&
+            bounds.outHeight / (sample * 2) >= HEIGHT && sample < 128) sample *= 2
+        val original = BitmapFactory.decodeFile(file.absolutePath, BitmapFactory.Options().apply {
+            inSampleSize = sample
+            inPreferredConfig = config
+        }) ?: return null
+        val scale = minOf(1.0, WIDTH.toDouble() / original.width, HEIGHT.toDouble() / original.height)
+        if (scale >= 1.0) return original
+        return try {
+            Bitmap.createScaledBitmap(original, maxOf(1, (original.width * scale).roundToInt()),
+                maxOf(1, (original.height * scale).roundToInt()), true)
+        } finally { original.recycle() }
+    }
+
+    /** A reserva de disco ja protege este temporario; nenhuma copia extra e criada. */
+    suspend fun prepareDownloaded(file: File, limit: Long): Boolean = withContext(Dispatchers.Default) {
+        try { conversions.withPermit {
+            currentCoroutineContext().ensureActive()
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            BitmapFactory.decodeFile(file.absolutePath, bounds)
+            if (bounds.outWidth in 1..WIDTH && bounds.outHeight in 1..HEIGHT) return@withPermit true
+            val bitmap = decode(file) ?: return@withPermit false
+            try {
+                val bytes = ByteArrayOutputStream().use { output ->
+                    if (!bitmap.compress(Bitmap.CompressFormat.JPEG, 90, output)) return@withPermit false
+                    output.toByteArray()
+                }
+                if (bytes.size.toLong() > limit) return@withPermit false
+                currentCoroutineContext().ensureActive()
+                file.writeBytes(bytes)
+                true
+            } finally { bitmap.recycle() }
+        } } catch (_: OutOfMemoryError) { false }
+    }
+}
