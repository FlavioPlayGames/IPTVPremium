+package br.com.flaviotorres.iptvpremium.data.repository
+
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.ui.test.*
+import androidx.compose.ui.test.junit4.createComposeRule
+import br.com.flaviotorres.iptvpremium.ui.components.*
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+
+class CatalogLayoutDeviceTest {
+    @get:Rule val compose = createComposeRule()
+
+    @Test fun bothModesFitTwoCompleteRowsForAllTextSizes() {
+        for ((width, height) in listOf(580f to 456f, 740f to 540f, 1000f to 740f)) {
+            for (columns in listOf(4, 5)) for (scale in listOf(1f, 1.1f, 1.2f)) {
+                val metadata = 26f * scale + 6f
+                val geometry = catalogTwoRowGeometry(width, height, columns, 10f, metadata)
+                assertTrue(geometry.posterWidth > 0f)
+                assertTrue(geometry.posterWidth <= (width - 16f - 10f * (columns - 1)) / columns + .01f)
+                assertEquals(height - 16f, geometry.cardHeight * 2 + geometry.rowSpacing, .01f)
+                assertTrue(8f + 2 * (geometry.cardHeight + geometry.rowSpacing) >= height - 8f)
+            }
+        }
+    }
+    @Test fun fourColumnsUseLargerArtworkOnTvLayout() {
+        val four = catalogTwoRowGeometry(740f, 540f, 4, 10f, 32f)
+        val five = catalogTwoRowGeometry(740f, 540f, 5, 10f, 32f)
+        assertTrue(four.posterWidth > five.posterWidth)
+    }
+    @Test fun previewChangesFromEightToTenPostersImmediately() {
+        val columns = mutableIntStateOf(4)
+        compose.setContent { CatalogLayoutPreview(columns.intValue) }
+        compose.onNodeWithContentDescription("Prévia: duas fileiras de 4 capas, 8 capas visíveis")
+            .assertExists()
+        compose.onNodeWithTag("preview-poster-7").assertExists()
+        compose.onNodeWithTag("preview-poster-8").assertDoesNotExist()
+        compose.runOnIdle { columns.intValue = 5 }
+        compose.onNodeWithContentDescription("Prévia: duas fileiras de 5 capas, 10 capas visíveis")
+            .assertExists()
+        compose.onNodeWithTag("preview-poster-9").assertExists()
+        compose.runOnIdle { columns.intValue = 4 }
+        compose.onNodeWithTag("preview-poster-9").assertDoesNotExist()
+    }
+}
