-/** Largest natural 2:3 poster that fits four cells and two complete rows. */
+internal const val CATALOG_POSTER_ASPECT = 2f / 3f
+internal const val CATALOG_POSTER_CORNER_DP = 4f
+
+internal data class CatalogTwoRowGeometry(
+    val posterWidth: Float,
+    val cardHeight: Float,
+    val rowSpacing: Float
+)
+
+/** Natural 2:3 artwork, two complete rows, and no sliver of a third row. */
+internal fun catalogTwoRowGeometry(width: Float, height: Float, columns: Int,
+    spacing: Float, metadata: Float, padding: Float = 8f): CatalogTwoRowGeometry {
+    if (width <= 0 || height <= 0 || columns <= 0) return CatalogTwoRowGeometry(0f, 0f, 0f)
+    val usableHeight = (height - padding * 2).coerceAtLeast(0f)
+    val cellWidth = ((width - padding * 2 - spacing * (columns - 1)) / columns).coerceAtLeast(0f)
+    val posterHeight = ((usableHeight - spacing) / 2f - metadata).coerceAtLeast(0f)
+    val posterWidth = minOf(cellWidth, posterHeight * CATALOG_POSTER_ASPECT)
+    val cardHeight = posterWidth / CATALOG_POSTER_ASPECT + metadata
+    return CatalogTwoRowGeometry(posterWidth, cardHeight,
+        (usableHeight - cardHeight * 2).coerceAtLeast(spacing))
+}
