+package br.com.flaviotorres.iptvpremium.data.cache
+
+import java.net.HttpURLConnection
+import java.net.URL
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class CatalogPosterRulesDeviceTest {
+    @Test fun fiveColumnsKeepTenVisibleAndOnlyTheNextTen() {
+        val first = catalogPosterWindow(0, 5)
+        assertEquals((0..9).toList(), first.visible.toList())
+        assertEquals((10..19).toList(), first.next.toList())
+        val down = catalogPosterWindow(10, 5)
+        assertEquals(first.next, down.visible)
+        assertEquals((20..29).toList(), down.next.toList())
+    }
+    @Test fun fourColumnsAndSingleRowScrollingFollowTheActualViewport() {
+        assertEquals(8..15, catalogPosterWindow(0, 4).next)
+        assertEquals(5..14, catalogPosterWindow(5, 5).visible)
+        assertEquals(15..24, catalogPosterWindow(5, 5).next)
+        for (columns in 4..5) for (position in 0..1000) {
+            val window = catalogPosterWindow(position, columns)
+            assertTrue(window.size <= 10)
+            assertTrue(window.visible.intersect(window.next.toSet()).isEmpty())
+            assertEquals(window.visible.last + 1, window.next.first)
+        }
+    }
+    @Test fun stopCancelsVisibleAndAnticipatedJobsAndClosesTheirConnections() = runBlocking {
+        val requests = CatalogPosterRequests()
+        val started = List(2) { CompletableDeferred<Unit>() }
+        val disconnected = List(2) { CompletableDeferred<Unit>() }
+        val work = List(2) { index -> launch {
+            requests.run {
+                requests.track(object : HttpURLConnection(URL("http://127.0.0.1/unused")) {
+                    override fun disconnect() { disconnected[index].complete(Unit) }
+                    override fun usingProxy() = false
+                    override fun connect() = Unit
+                })
+                started[index].complete(Unit)
+                awaitCancellation()
+            }
+        } }
+        started.forEach { it.await() }
+        requests.stop()
+        assertFalse(requests.enabled.value)
+        withTimeout(2_000) { work.joinAll(); disconnected.forEach { it.await() } }
+        assertTrue(work.all { it.isCancelled })
+    }
+    @Test fun stoppingCatalogCannotCancelTheChosenDetailRequest() = runBlocking {
+        val requests = CatalogPosterRequests()
+        val detailReady = CompletableDeferred<Unit>()
+        val detail = async { detailReady.await(); "chosen item ready" }
+        requests.stop()
+        detailReady.complete(Unit)
+        assertEquals("chosen item ready", detail.await())
+    }
+    @Test fun stoppedCatalogRejectsNewWorkAndCanResumeOnReturn() = runBlocking {
+        val requests = CatalogPosterRequests()
+        var executed = false
+        requests.stop()
+        try { requests.run { executed = true }; fail("Stopped requests must not start") }
+        catch (_: CancellationException) { }
+        assertFalse(executed)
+        requests.resume()
+        assertEquals(42, requests.run { 42 })
+        requests.stop()
+    }
+}
