+package br.com.flaviotorres.iptvpremium.data.cache
+
+import java.net.HttpURLConnection
+import kotlin.coroutines.AbstractCoroutineContextElement
+import kotlin.coroutines.CoroutineContext
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Owned by a catalog entry. Detail artwork uses independent, unaffected requests. */
+internal class CatalogPosterRequests : AbstractCoroutineContextElement(Key) {
+    companion object Key : CoroutineContext.Key<CatalogPosterRequests> {
+        private val cleanup = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    }
+    private val lock = Any()
+    private val active = MutableStateFlow(true)
+    val enabled = active.asStateFlow()
+    private val jobs = mutableSetOf<Job>()
+    private val connections = mutableSetOf<HttpURLConnection>()
+
+    suspend fun <T> run(block: suspend () -> T): T = coroutineScope {
+        val job = currentCoroutineContext().job
+        synchronized(lock) {
+            if (!active.value) throw CancellationException("Catalog artwork paused")
+            jobs.add(job)
+        }
+        try { withContext(this@CatalogPosterRequests) { block() } }
+        finally { synchronized(lock) { jobs.remove(job) } }
+    }
+    fun track(connection: HttpURLConnection) {
+        synchronized(lock) {
+            if (!active.value) throw CancellationException("Catalog artwork paused")
+            connections.add(connection)
+        }
+    }
+    fun untrack(connection: HttpURLConnection) { synchronized(lock) { connections.remove(connection) } }
+    fun resume() { synchronized(lock) { active.value = true } }
+    fun stop() {
+        val pending: Pair<List<Job>, List<HttpURLConnection>> = synchronized(lock) {
+            active.value = false
+            (jobs.toList() to connections.toList()).also { connections.clear() }
+        }
+        // Cancellation happens before navigation. Socket closure never blocks the UI thread.
+        pending.first.forEach { it.cancel() }
+        pending.second.forEach { connection -> cleanup.launch { runCatching { connection.disconnect() } } }
+    }
+}
