+package br.com.flaviotorres.iptvpremium.ui.components
+
+import androidx.compose.runtime.*
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import br.com.flaviotorres.iptvpremium.data.cache.CatalogPosterRequests
+import br.com.flaviotorres.iptvpremium.data.cache.CatalogPosterWindow
+
+internal val LocalCatalogPosterRequests = staticCompositionLocalOf<CatalogPosterRequests?> { null }
+internal val LocalCatalogPosterWindow = staticCompositionLocalOf { CatalogPosterWindow(0, Int.MAX_VALUE / 2) }
+
+@Composable
+internal fun rememberCatalogPosterRequests(): CatalogPosterRequests {
+    val requests = remember { CatalogPosterRequests() }
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    DisposableEffect(lifecycle, requests) {
+        val observer = LifecycleEventObserver { _, event ->
+            when (event) {
+                Lifecycle.Event.ON_RESUME -> requests.resume()
+                Lifecycle.Event.ON_PAUSE, Lifecycle.Event.ON_STOP, Lifecycle.Event.ON_DESTROY -> requests.stop()
+                else -> Unit
+            }
+        }
+        lifecycle.addObserver(observer)
+        onDispose { lifecycle.removeObserver(observer); requests.stop() }
+    }
+    return requests
+}
