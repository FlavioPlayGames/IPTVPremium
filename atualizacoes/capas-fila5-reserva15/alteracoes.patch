+package br.com.flaviotorres.iptvpremium.data.cache
+
+/** Cursor por categoria: tres grupos de cinco; repoe quando restam dez. */
+internal class PosterAheadQueue {
+    private var completedUntil = 0
+    private var previousAfter = -1
+    private var refillUntil = 0
+
+    fun nextBatch(afterVisible: Int, loadedStart: Int, loadedEnd: Int): IntRange? {
+        val after = afterVisible.coerceAtLeast(0)
+        if (previousAfter < 0 || after < previousAfter || after > completedUntil) {
+            completedUntil = after
+            refillUntil = after
+        }
+        previousAfter = after
+        if (completedUntil - after <= REFILL_AT) {
+            refillUntil = maxOf(refillUntil, (after.toLong() + AHEAD).coerceAtMost(Int.MAX_VALUE.toLong()).toInt())
+        }
+        val start = maxOf(after, completedUntil, loadedStart)
+        val end = minOf((start.toLong() + GROUP).coerceAtMost(Int.MAX_VALUE.toLong()).toInt(), refillUntil, loadedEnd)
+        return if (start < end) start until end else null
+    }
+
+    /** Avanca somente depois da conclusao; cancelamentos nao pulam grupos. */
+    fun completed(batch: IntRange) { completedUntil = maxOf(completedUntil, batch.last + 1) }
+
+    companion object {
+        const val GROUP = 5
+        const val AHEAD = 15
+        const val REFILL_AT = 10
+    }
+}
