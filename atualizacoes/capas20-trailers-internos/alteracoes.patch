+import org.junit.Test
+
+class DetailsArtworkPriorityDeviceTest {
+    @get:Rule val compose = createComposeRule()
+    @Test fun movieLogoAndBackdropStartBeforeActorPhoto() {
+        val server = ServerSocket(0)
+        val paths = ConcurrentLinkedQueue<String>()
+        val clients = ConcurrentLinkedQueue<Socket>()
+        val release = CountDownLatch(1)
+        val primaryRequested = CountDownLatch(2)
+        val image = java.io.ByteArrayOutputStream().also { output ->
+            Bitmap.createBitmap(16, 16, Bitmap.Config.ARGB_8888).apply { eraseColor(android.graphics.Color.BLUE) }
+                .compress(Bitmap.CompressFormat.PNG, 100, output)
+        }.toByteArray()
+        kotlin.concurrent.thread(isDaemon = true) {
+            try { while (!server.isClosed) {
+                val socket = server.accept(); clients.add(socket)
+                kotlin.concurrent.thread(isDaemon = true) {
+                    try { socket.use {
+                        val reader = it.getInputStream().bufferedReader()
+                        val path = reader.readLine().split(' ')[1]
+                        while (!reader.readLine().isNullOrEmpty()) { }
+                        paths.add(path)
+                        if (path != "/actor.png") {
+                            primaryRequested.countDown()
+                            release.await(4, TimeUnit.SECONDS)
+                        }
+                        it.getOutputStream().apply {
+                            write("HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: ${image.size}\r\nConnection: close\r\n\r\n".toByteArray())
+                            write(image); flush()
+                        }
+                    } } catch (_: Exception) { }
+                }
+            } } catch (_: Exception) { }
+        }
+        val base = "http://127.0.0.1:${server.localPort}"
+        try {
+            compose.setContent {
+                Box(Modifier.requiredSize(960.dp, 540.dp)) {
+                    MovieDetailsScreen(movieName = "Teste local", backdropUrl = "$base/background.png",
+                        titleLogoUrl = "$base/logo.png", cast = listOf(MovieCastMember("actor", "Ator", "$base/actor.png")))
+                }
+            }
+            compose.waitUntil(3_000) { primaryRequested.count == 0L }
+            assertFalse(paths.contains("/actor.png"))
+            release.countDown()
+            compose.waitUntil(5_000) { paths.contains("/actor.png") }
+            val order = paths.toList()
+            assertTrue(order.indexOf("/actor.png") > order.indexOf("/background.png"))
+            assertTrue(order.indexOf("/actor.png") > order.indexOf("/logo.png"))
+        } finally {
+            release.countDown(); server.close(); clients.forEach { runCatching { it.close() } }
+        }
+    }
+}
