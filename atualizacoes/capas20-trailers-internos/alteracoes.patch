+var player;
+function onYouTubeIframeAPIReady(){player=new YT.Player('player',{width:'100%',height:'100%',videoId:'$id',
+playerVars:{autoplay:1,playsinline:1,controls:1,fs:0,rel:0,hl:'pt-BR',cc_lang_pref:'pt',cc_load_policy:1,origin:'${identity.trimEnd('/')}'},
+events:{onReady:function(){TrailerHost.ready();player.playVideo()},onError:function(e){TrailerHost.failed(e.data)}}})}
+function toggleTrailer(){if(player&&player.getPlayerState){if(player.getPlayerState()==1)player.pauseVideo();else player.playVideo()}}
+function seekTrailer(seconds){if(player&&player.getCurrentTime)player.seekTo(Math.max(0,player.getCurrentTime()+seconds),true)}
+</script></body></html>"""
+}
