+package br.com.flaviotorres.iptvpremium.data.cache
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+
+/** UI-thread queue: overlapping windows keep their in-flight downloads. */
+internal class CatalogPosterPreloader(private val scope: CoroutineScope,
+    private val load: suspend (String) -> Unit) {
+    private val jobs = linkedMapOf<String, Job>()
+    fun update(next: List<String?>, retain: List<String?>) {
+        val wanted = next.mapNotNull { it?.trim()?.takeIf(String::isNotEmpty) }.distinct().take(20)
+        val kept = retain.filterNotNull().map(String::trim).toSet() + wanted
+        val removed = jobs.keys.filter { it !in kept }
+        removed.forEach { jobs.remove(it)?.cancel() }
+        wanted.forEach { url -> if (url !in jobs) jobs[url] = scope.launch { load(url) } }
+    }
+    fun clear() { jobs.values.forEach { it.cancel() }; jobs.clear() }
+}
