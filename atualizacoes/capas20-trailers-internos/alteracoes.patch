+package br.com.flaviotorres.iptvpremium.data.cache
+
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import br.com.flaviotorres.iptvpremium.ui.movies.MoviePosterLoader
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.atomic.AtomicReference
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class CatalogPosterQueueDeviceTest {
+    @Test fun overlappingWindowsDoNotRestartInFlightPosters() = runBlocking {
+        val started = mutableMapOf<String, Int>()
+        val queue = CatalogPosterPreloader(this) { url -> started[url] = (started[url] ?: 0) + 1; awaitCancellation() }
+        queue.update((10..29).map { "url-$it" }, (0..9).map { "url-$it" })
+        yield()
+        assertEquals(20, started.size)
+        queue.update((15..34).map { "url-$it" }, (5..14).map { "url-$it" })
+        yield()
+        assertEquals(25, started.size)
+        assertTrue(started.values.all { it == 1 })
+        queue.clear()
+    }
+    @Test fun completedPostersAreNotRequestedAgainWithinTheWindow() = runBlocking {
+        var count = 0
+        val queue = CatalogPosterPreloader(this) { count++ }
+        val next = (10..29).map { "url-$it" }
+        queue.update(next, emptyList()); yield()
+        queue.update(next, emptyList()); yield()
+        assertEquals(20, count)
+        queue.clear()
+    }
+    @Test fun cancellingBlockedPosterDoesNotWaitForReadTimeout() = runBlocking {
+        val server = ServerSocket(0)
+        val client = AtomicReference<Socket?>()
+        val started = CompletableDeferred<Unit>()
+        val release = java.util.concurrent.CountDownLatch(1)
+        val thread = kotlin.concurrent.thread(isDaemon = true) {
+            try {
+                server.accept().use { socket ->
+                    client.set(socket)
+                    val reader = socket.getInputStream().bufferedReader()
+                    while (!reader.readLine().isNullOrEmpty()) { }
+                    socket.getOutputStream().apply {
+                        write("HTTP/1.1 200 OK\r\nContent-Length: 1048576\r\nConnection: close\r\n\r\nx".toByteArray()); flush()
+                    }
+                    started.complete(Unit)
+                    release.await(5, java.util.concurrent.TimeUnit.SECONDS)
+                }
+            } catch (_: Exception) { }
+        }
+        val requests = CatalogPosterRequests()
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        val job = launch { requests.run { MoviePosterLoader.prefetch(context, "http://127.0.0.1:${server.localPort}/poster") } }
+        try {
+            withTimeout(3_000) { started.await() }
+            job.cancel()
+            withTimeout(700) { job.join() }
+            assertTrue(job.isCancelled)
+        } finally {
+            requests.stop(); release.countDown(); client.get()?.close(); server.close(); thread.join(1_000)
+        }
+    }
+}
