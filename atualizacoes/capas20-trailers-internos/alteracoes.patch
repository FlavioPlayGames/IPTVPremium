+package br.com.flaviotorres.iptvpremium.core.media
+
+import br.com.flaviotorres.iptvpremium.data.remote.TmdbClientProvider
+import java.net.URI
+import java.text.Normalizer
+import kotlinx.coroutines.*
+import org.json.JSONArray
+import org.json.JSONObject
+
+internal data class TrailerRequest(val title: String, val raw: String? = null,
+    val kind: String = "movie", val tmdbId: String? = null, val year: Int? = null)
+internal data class TrailerChoice(val url: String, val youtubeId: String? = null,
+    val language: String? = null, val name: String = "Trailer")
+
+internal fun youtubeTrailerId(raw: String?): String? {
+    val address = trailerAddress(raw, "") ?: return null
+    val uri = runCatching { URI(address) }.getOrNull() ?: return null
+    if (uri.host?.lowercase() !in setOf("youtube.com", "www.youtube.com")) return null
+    return uri.rawQuery?.split('&')?.firstOrNull { it.startsWith("v=") }
+        ?.substringAfter('=')?.takeIf { it.matches(Regex("[A-Za-z0-9_-]{11}")) }
+}
+internal fun providerTrailer(raw: String?): TrailerChoice? {
+    youtubeTrailerId(raw)?.let { return TrailerChoice("https://www.youtube.com/watch?v=$it", it) }
+    val uri = runCatching { URI(raw?.trim().orEmpty()) }.getOrNull() ?: return null
+    if (uri.scheme?.lowercase() !in setOf("http", "https") || uri.host.isNullOrBlank() || uri.rawUserInfo != null) return null
+    if (!uri.path.orEmpty().lowercase().matches(Regex(".*\\.(mp4|m3u8|mpd|webm|mov)$"))) return null
+    return TrailerChoice(uri.toASCIIString())
+}
+internal fun trailerSearchTitle(title: String): String = title
+    .replace(Regex("\\[(?:L|D|LEG|DUB|DUBLADO|LEGENDADO|4K|HDR|HD|FHD)\\]", RegexOption.IGNORE_CASE), " ")
+    .replace(Regex("\\b(?:4K|1080p|720p|2160p|HDR|DUBLADO|LEGENDADO)\\b", RegexOption.IGNORE_CASE), " ")
+    .replace(Regex("\\s*\\((?:19|20)\\d{2}\\)\\s*$"), " ")
+    .trim().trimStart('★', '✽', '*', ' ', '-', '|').replace(Regex("\\s+"), " ").trim()
+private fun titleKey(value: String) = Normalizer.normalize(value, Normalizer.Form.NFD)
+    .replace(Regex("\\p{M}"), "").lowercase().replace(Regex("[^a-z0-9]+"), " ").trim()
+
+internal class TrailerResolver(private val get: suspend (String, Map<String, String>) -> String =
+    { path, query -> TmdbClientProvider.client.get(path, query) }) {
+    suspend fun resolve(request: TrailerRequest): List<TrailerChoice> {
+        val fallback = providerTrailer(request.raw)
+        val kind = if (request.kind == "tv") "tv" else "movie"
+        val title = trailerSearchTitle(request.title)
+        var id = request.tmdbId?.takeIf { it.matches(Regex("[1-9][0-9]*")) }
+        if (id == null && title.isNotBlank()) {
+            val query = mutableMapOf("query" to title, "language" to "pt-BR", "include_adult" to "false")
+            request.year?.takeIf { it in 1888..2100 }?.let { query[if (kind == "tv") "first_air_date_year" else "year"] = it.toString() }
+            val results = json("/search/$kind", query).optJSONArray("results") ?: JSONArray()
+            val wanted = titleKey(title)
+            id = (0 until results.length()).mapNotNull { results.optJSONObject(it) }.firstOrNull { candidate ->
+                val names = listOf(candidate.optString("title"), candidate.optString("original_title"),
+                    candidate.optString("name"), candidate.optString("original_name"))
+                names.any { titleKey(it) == wanted }
+            }?.optLong("id")?.takeIf { it > 0 }?.toString()
+        }
+        if (id == null) return listOfNotNull(fallback)
+        val videos = coroutineScope {
+            listOf("pt-BR", "en-US").map { language -> async {
+                json("/$kind/$id/videos", mapOf("language" to language))
+                    .optJSONArray("results") ?: JSONArray()
+            } }.awaitAll()
+        }
+        return rank(videos).plus(listOfNotNull(fallback)).distinctBy { it.url }.take(10)
+    }
+    private suspend fun json(path: String, query: Map<String, String>): JSONObject = try {
+        JSONObject(get(path, query))
+    } catch (cancelled: CancellationException) { throw cancelled }
+      catch (_: Exception) { JSONObject() }
+
+    internal fun rank(arrays: List<JSONArray>): List<TrailerChoice> = arrays.flatMap { array ->
+        (0 until array.length()).mapNotNull { index ->
+            val video = array.optJSONObject(index) ?: return@mapNotNull null
+            val key = video.optString("key")
+            val type = video.optString("type")
+            if (video.optString("site") != "YouTube" || type !in setOf("Trailer", "Teaser") ||
+                !key.matches(Regex("[A-Za-z0-9_-]{11}"))) return@mapNotNull null
+            val name = video.optString("name")
+            val normalized = titleKey(name)
+            val language = video.optString("iso_639_1").takeIf { it.isNotBlank() }
+            val explicitPortuguese = listOf("dublado", "legendado", "portugues", "pt br").any { normalized.contains(it) }
+            val portuguese = language == "pt" || explicitPortuguese
+            val score = (if (portuguese) 1000 else 0) +
+                (if (normalized.contains("dublado")) 150 else if (normalized.contains("legendado")) 100 else 0) +
+                (if (type == "Trailer") 40 else 0) + (if (video.optBoolean("official")) 20 else 0)
+            score to TrailerChoice("https://www.youtube.com/watch?v=$key", key,
+                if (portuguese) "pt" else language, name)
+        }
+    }.sortedByDescending { it.first }.map { it.second }.distinctBy { it.url }
+}
