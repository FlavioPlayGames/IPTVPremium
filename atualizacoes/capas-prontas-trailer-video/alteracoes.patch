+package br.com.flaviotorres.iptvpremium.data.cache
+
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class PreparedPosterCacheDeviceTest {
+    @Test fun nearestRowSurvivesWhenFartherImagesFillTheBudget() {
+        val cache = PreparedPosterCache<String, Long>(100) { it }
+        cache.window(listOf("next-1", "next-2", "far"))
+        cache.put("far", 60)
+        cache.put("next-1", 60)
+        cache.put("next-2", 40)
+        assertEquals(60L, cache.get("next-1"))
+        assertEquals(40L, cache.get("next-2"))
+        assertNull(cache.get("far"))
+        assertEquals(100L, cache.allocatedBytes())
+    }
+    @Test fun preparedImagesAreReturnedForPromotionWhenTheyBecomeVisible() {
+        val cache = PreparedPosterCache<String, String>(100) { 20 }
+        cache.window(listOf("next-1", "next-2"))
+        cache.put("next-1", "decoded")
+        assertEquals(listOf("next-1" to "decoded"), cache.window(listOf("next-2", "next-3")))
+        assertFalse(cache.wants("next-1"))
+        cache.clear()
+        assertEquals(0L, cache.allocatedBytes())
+    }
+    @Test fun completedDiskDownloadsCanBePromotedToPreparedImagesLater() = runBlocking {
+        val ready = mutableSetOf<String>()
+        val calls = mutableMapOf<String, Int>()
+        var near = "url-10"
+        val queue = CatalogPosterPreloader(this, ready = { it != near || it in ready }) { url ->
+            calls[url] = (calls[url] ?: 0) + 1
+            if (url == near) ready.add(url)
+        }
+        val urls = (10..29).map { "url-$it" }
+        queue.update(urls, emptyList()); yield()
+        assertTrue("url-10" in ready)
+        near = "url-15"
+        queue.update(urls, emptyList()); yield()
+        assertTrue("url-15" in ready)
+        assertEquals(2, calls["url-15"])
+        assertEquals(1, calls["url-20"])
+        queue.clear()
+    }
+}
