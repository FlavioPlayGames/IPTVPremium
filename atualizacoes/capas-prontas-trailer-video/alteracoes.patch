+    @get:Rule val compose = createComposeRule()
+    @Test fun nextMovieRowIsDecodedBeforeTheUserScrolls() {
+        val server = ServerSocket(0)
+        val clients = ConcurrentLinkedQueue<Socket>()
+        val paths = ConcurrentLinkedQueue<String>()
+        val image = java.io.ByteArrayOutputStream().also { out ->
+            Bitmap.createBitmap(16, 24, Bitmap.Config.ARGB_8888).apply { eraseColor(android.graphics.Color.BLUE) }
+                .compress(Bitmap.CompressFormat.PNG, 100, out)
+        }.toByteArray()
+        kotlin.concurrent.thread(isDaemon = true) {
+            try { while (!server.isClosed) {
+                val socket = server.accept(); clients.add(socket)
+                kotlin.concurrent.thread(isDaemon = true) {
+                    try { socket.use {
+                        val reader = it.getInputStream().bufferedReader()
+                        val path = reader.readLine().split(' ')[1]
+                        while (!reader.readLine().isNullOrEmpty()) { }
+                        paths.add(path)
+                        it.getOutputStream().apply {
+                            write("HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: ${image.size}\r\nConnection: close\r\n\r\n".toByteArray())
+                            write(image); flush()
+                        }
+                    } } catch (_: Exception) { }
+                }
+            } } catch (_: Exception) { }
+        }
+        val base = "http://127.0.0.1:${server.localPort}"
+        val data = flowOf(PagingData.from(List(40) { Movie("m$it", "Filme $it", null, "$base/$it.png", null, "", 2026, 8.0, null) }, sourceLoadStates = androidx.paging.LoadStates(androidx.paging.LoadState.NotLoading(false), androidx.paging.LoadState.NotLoading(true), androidx.paging.LoadState.NotLoading(true))))
+        try {
+            compose.setContent {
+                val movies = data.collectAsLazyPagingItems()
+                Box(Modifier.requiredSize(960.dp, 540.dp)) { MoviesScreen(pagedMovies = movies, totalMovieCount = 40) }
+            }
+            compose.waitUntil(7_000) { (10..14).all { MoviePosterLoader.peekBitmap("$base/$it.png") != null } }
+            compose.waitUntil(7_000) { (10..29).all { paths.contains("/$it.png") } }
+            compose.onNodeWithContentDescription("Filme 10").assertDoesNotExist()
+            assertTrue((10..14).all { paths.contains("/$it.png") })
+            compose.onNodeWithTag("movie-category-ALL").performKeyInput { pressKey(Key.DirectionRight) }
+            compose.waitForIdle()
+            compose.onAllNodes(isFocused()).onFirst().performKeyInput { repeat(2) { pressKey(Key.DirectionDown) } }
+            compose.mainClock.advanceTimeBy(700)
+            compose.onNodeWithContentDescription("Filme 10").assertIsDisplayed()
+            assertEquals(1, paths.count { it == "/10.png" })
+            MoviePosterLoader.clearMemory()
+            val context = androidx.test.core.app.ApplicationProvider.getApplicationContext<android.content.Context>()
+            kotlinx.coroutines.runBlocking {
+                assertNotNull(MoviePosterLoader.loadCached(context, "$base/10.png"))
+                assertNull(MoviePosterLoader.loadCached(context, "$base/never-downloaded.png"))
+            }
+            assertEquals(1, paths.count { it == "/10.png" })
+            assertFalse(paths.contains("/never-downloaded.png"))
+        } finally {
+            server.close(); clients.forEach { runCatching { it.close() } }
+        }
+    }
+}
