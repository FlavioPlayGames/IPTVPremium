+package br.com.flaviotorres.iptvpremium.core.media
+
+import android.content.Context
+import android.content.Intent
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import androidx.test.core.app.ActivityScenario
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.*
+import org.junit.Test
+
+class TrailerReturnDeviceTest {
+    @Test fun noBackButtonAndHardwareEscapeClosesTheScreen() {
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        val intent = Intent(context, TrailerPlayerActivity::class.java).putExtra("title", "")
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        ActivityScenario.launch<TrailerPlayerActivity>(intent).use { scenario ->
+            scenario.onActivity { activity ->
+                fun buttons(view: View): List<Button> = when (view) {
+                    is Button -> listOf(view)
+                    is ViewGroup -> (0 until view.childCount).flatMap { buttons(view.getChildAt(it)) }
+                    else -> emptyList()
+                }
+                assertFalse(buttons(activity.window.decorView).any { it.text.toString().contains("Voltar") })
+                val surface = android.widget.FrameLayout(activity)
+                var hidden = false
+                val callback = android.webkit.WebChromeClient.CustomViewCallback { hidden = true }
+                TrailerPlayerActivity::class.java.getDeclaredMethod("showCustomVideo", View::class.java,
+                    android.webkit.WebChromeClient.CustomViewCallback::class.java).apply { isAccessible = true }
+                    .invoke(activity, surface, callback)
+                assertNotNull(surface.parent)
+                assertEquals(View.VISIBLE, surface.visibility)
+                TrailerPlayerActivity::class.java.getDeclaredMethod("hideCustomVideo").apply { isAccessible = true }.invoke(activity)
+                assertNull(surface.parent)
+                assertTrue(hidden)
+                assertTrue(activity.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_UP, KeyEvent.KEYCODE_ESCAPE)))
+                assertTrue(activity.isFinishing)
+            }
+        }
+    }
+}
