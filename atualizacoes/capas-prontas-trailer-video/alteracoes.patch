+package br.com.flaviotorres.iptvpremium.data.cache
+
+/** A bounded next-row cache. Farthest images are evicted before the next row. */
+internal class PreparedPosterCache<K, V>(private val maxBytes: Long, private val size: (V) -> Long) {
+    private var order = emptyList<K>()
+    private val images = linkedMapOf<K, V>()
+    private var bytes = 0L
+    @Synchronized fun window(keys: List<K>): List<Pair<K, V>> {
+        order = keys.distinct()
+        val promoted = images.entries.filter { it.key !in order }.map { it.key to it.value }
+        promoted.forEach { (key, value) -> images.remove(key); bytes -= size(value) }
+        trim()
+        return promoted
+    }
+    @Synchronized fun wants(key: K): Boolean = key in order
+    @Synchronized fun get(key: K): V? = images[key]
+    @Synchronized fun put(key: K, image: V) {
+        if (key !in order) return
+        images.put(key, image)?.let { bytes -= size(it) }
+        bytes += size(image)
+        trim()
+    }
