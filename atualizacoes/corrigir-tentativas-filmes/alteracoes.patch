+package br.com.flaviotorres.iptvpremium.core.network
+
+import kotlin.coroutines.AbstractCoroutineContextElement
+import kotlin.coroutines.CoroutineContext
+
+/** Only explicit movie opening uses a fresh foreground request after a timed-out attempt. */
+internal class MovieOpeningAttempt(val number: Int) : AbstractCoroutineContextElement(Key) {
+    companion object Key : CoroutineContext.Key<MovieOpeningAttempt>
+}
