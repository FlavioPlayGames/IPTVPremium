+package br.com.flaviotorres.iptvpremium.data.cache
+
+/** Metadata is invalidated by real source/access changes, not by leaving a destination. */
+internal class CatalogSessionRevisions {
+    private data class Revision(val playlist:String,val generation:String?,val access:Any?)
+    private val revisions=mutableMapOf<String,Revision>()
+    fun bind(section:String,playlist:String,generation:String?,access:Any?,bind:()->Unit,refresh:()->Unit) {
+        val next=Revision(playlist,generation,access)
+        val previous=revisions[section]
+        if(previous==next)return
+        bind()
+        if(previous?.playlist==playlist)refresh()
+        revisions[section]=next
+    }
+    fun clear(section:String) {revisions.remove(section)}
+}
