+package br.com.flaviotorres.iptvpremium.core.player
+
+enum class PlaybackImageMode(val title: String) {
+    OFF("Desativada"), LIGHT("Leve · nitidez adaptativa"), FSR1("FSR 1 + RCAS · experimental")
+}
+enum class PlaybackImageStrength(val title: String, val amount: Float) {
+    SOFT("Suave", .35f), MEDIUM("Média", .55f), STRONG("Forte", .75f)
+}
+data class PlaybackImageEnhancement(
+    val mode: PlaybackImageMode = PlaybackImageMode.OFF,
+    val strength: PlaybackImageStrength = PlaybackImageStrength.SOFT
+)
+
+internal object PlaybackImagePolicy {
+    fun unsupported(mode: PlaybackImageMode, hdr: Boolean, drm: Boolean,
+                    width: Int, height: Int, fps: Float = 0f): String? = when {
+        mode == PlaybackImageMode.OFF -> null
+        drm -> "Melhoria desativada: vídeo protegido."
+        hdr -> "Melhoria desativada neste vídeo HDR/Dolby Vision."
+        maxOf(width, height) > 1920 || minOf(width, height) > 1080 -> "Melhoria disponível até 1080p SDR."
+        mode == PlaybackImageMode.FSR1 && fps > 30.5f -> "FSR 1 disponível para vídeos de até 30 FPS."
+        else -> null
+    }
+    fun outputSize(width: Int, height: Int, displayWidth: Int, displayHeight: Int): Pair<Int, Int> {
+        require(width > 0 && height > 0)
+        val limitW = displayWidth.coerceIn(1, 1920)
+        val limitH = displayHeight.coerceIn(1, 1080)
+        val scale = minOf(2f, limitW.toFloat() / width, limitH.toFloat() / height).coerceAtLeast(1f)
+        return (width * scale).toInt().coerceAtLeast(width) to (height * scale).toInt().coerceAtLeast(height)
+    }
+}
