+package br.com.flaviotorres.iptvpremium.core.player
+
+import android.os.Looper
+import android.view.SurfaceHolder
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.platform.app.InstrumentationRegistry
+import br.com.flaviotorres.iptvpremium.ui.settings.SettingsPreferences
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import org.junit.Assert.*
+import org.junit.Test
+import java.lang.reflect.Proxy
+
+class PlaybackImageDeviceTest {
+    private fun main(action: () -> Unit) = InstrumentationRegistry.getInstrumentation().runOnMainSync(action)
+    private class Fake(val engine: PlaybackEngine) {
+        val state = MutableStateFlow(PlaybackUiState(engine = engine))
+        val capabilities = MutableStateFlow(PlaybackEngineCapabilities())
+        val events = MutableSharedFlow<PlaybackEngineEvent>(extraBufferCapacity = 8)
+        var request: PlaybackOpenRequest? = null
+        var released = false
+        val adapter = Proxy.newProxyInstance(PlaybackEngineAdapter::class.java.classLoader,
+            arrayOf(PlaybackEngineAdapter::class.java)) { _, method, args ->
+            when (method.name) {
+                "getEngine" -> engine
+                "getState" -> state
+                "getCapabilities" -> capabilities
+                "getEvents" -> events
+                "prepare" -> {
+                    request = args!![0] as PlaybackOpenRequest
+                    state.value = PlaybackUiState(media = request!!.media, engine = engine,
+                        status = if (request!!.playWhenReady) PlaybackStatus.PLAYING else PlaybackStatus.PAUSED,
+                        positionMs = request!!.startPositionMs, durationMs = 600_000,
+                        imageEnhancement = request!!.settings.imageEnhancement)
+                    PlaybackCommandResult.ACCEPTED
+                }
+                "release" -> { released = true; null }
+                "detachVideoSurface" -> null
+                else -> PlaybackCommandResult.ACCEPTED
+            }
+        } as PlaybackEngineAdapter
+    }
+    private val media = PlaybackMedia("movie", PlaybackContentType.MOVIE, "Test", "https://example.invalid/movie.mp4")
+    @Test fun defaultsAreOffAndPreferencesRoundTripBothModesAndStrengths() {
+        val settings = SettingsPreferences(ApplicationProvider.getApplicationContext())
+        settings.prefs.edit().remove("image_mode").remove("image_strength").commit()
+        assertEquals(PlaybackImageMode.OFF, settings.playback().imageEnhancement.mode)
+        for (mode in PlaybackImageMode.entries) for (strength in PlaybackImageStrength.entries) {
+            val expected = PlaybackImageEnhancement(mode, strength)
+            settings.setImageEnhancement(expected)
+            assertEquals(expected, settings.playback().imageEnhancement)
+        }
+        settings.prefs.edit().putString("image_mode", "unknown").putString("image_strength", "unknown").commit()
+        assertEquals(PlaybackImageEnhancement(), settings.playback().imageEnhancement)
+    }
+    @Test fun fsrOutputRespectsAspect1080pCapAndTwoTimesMaximumScale() {
+        assertEquals(1920 to 1080, PlaybackImagePolicy.outputSize(1280,720,3840,2160))
+        assertEquals(1920 to 816, PlaybackImagePolicy.outputSize(1280,544,1920,1080))
+        assertEquals(1280 to 720, PlaybackImagePolicy.outputSize(640,360,1920,1080))
+        assertEquals(1920 to 1080, PlaybackImagePolicy.outputSize(1920,1080,1280,720))
+    }
+    @Test fun compatibilityProtectsHdrDrm4kAndHighFrameRateFsr() {
+        assertNotNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.LIGHT,true,false,1280,720))
+        assertNotNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.FSR1,false,true,1280,720))
+        assertNotNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.LIGHT,false,false,3840,2160))
+        assertNotNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.FSR1,false,false,1280,720,60f))
+        assertNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.FSR1,false,false,1280,720,24f))
+        assertNull(PlaybackImagePolicy.unsupported(PlaybackImageMode.LIGHT,false,false,1280,720,60f))
+        assertTrue(PlaybackImageEffects.create(ApplicationProvider.getApplicationContext(), PlaybackImageEnhancement(), {}).isEmpty())
+    }
+    @Test fun changingModeRetainsPositionPauseSpeedAndAudioAndReleasesOldDecoderFirst() = main {
+        val fakes = mutableListOf<Fake>()
+        val controller = PlaybackController(ApplicationProvider.getApplicationContext(), factory = PlaybackEngineAdapterFactory { engine ->
+            assertTrue(fakes.all { it.released })
+            Fake(engine).also { fakes += it }.adapter
+        })
+        try {
+            controller.open(PlaybackOpenRequest(media,180_000,false,PlaybackSettings(speed=1.25f,audioLanguageTag="pt")))
+            for (mode in listOf(PlaybackImageMode.LIGHT, PlaybackImageMode.FSR1, PlaybackImageMode.OFF)) {
+                assertEquals(PlaybackCommandResult.ACCEPTED,controller.setImageEnhancement(PlaybackImageEnhancement(mode)))
+                val request = fakes.last().request!!
+                assertEquals(180_000L,request.startPositionMs)
+                assertFalse(request.playWhenReady)
+                assertEquals(1.25f,request.settings.speed,0f)
+                assertEquals("pt",request.settings.audioLanguageTag)
+                assertEquals(mode,request.settings.imageEnhancement.mode)
+            }
+        } finally { controller.release() }
+    }
+    @Test fun vlcDoesNotPretendToApplyTheMedia3Shaders() = main {
+        val fakes=mutableListOf<Fake>()
+        val controller=PlaybackController(ApplicationProvider.getApplicationContext(),factory=PlaybackEngineAdapterFactory { e -> Fake(e).also{fakes+=it}.adapter })
+        try {
+            controller.open(PlaybackOpenRequest(media,settings=PlaybackSettings(preferredEngine=PlaybackEngine.VLC)))
+            assertEquals(PlaybackCommandResult.UNSUPPORTED,controller.setImageEnhancement(PlaybackImageEnhancement(PlaybackImageMode.FSR1)))
+            assertEquals(1,fakes.size)
+        } finally {controller.release()}
+    }
+    @Test fun repeatedBypassEventsNeverCreateAnotherShaderSession() {
+        val fakes=mutableListOf<Fake>()
+        lateinit var controller: PlaybackController
+        main {
+            controller=PlaybackController(ApplicationProvider.getApplicationContext(),factory=PlaybackEngineAdapterFactory { e -> Fake(e).also{fakes+=it}.adapter })
+            controller.open(PlaybackOpenRequest(media,60_000,false,PlaybackSettings(imageEnhancement=PlaybackImageEnhancement(PlaybackImageMode.FSR1))))
+            fakes.first().events.tryEmit(PlaybackEngineEvent.ImageEnhancementBypassed("test"))
+        }
+        InstrumentationRegistry.getInstrumentation().waitForIdleSync()
+        main {
+            try {
+                assertEquals(2,fakes.size)
+                assertEquals(PlaybackImageMode.OFF,fakes.last().request!!.settings.imageEnhancement.mode)
+                assertEquals(60_000L,fakes.last().request!!.startPositionMs)
+                assertFalse(fakes.last().request!!.playWhenReady)
+                fakes.first().events.tryEmit(PlaybackEngineEvent.ImageEnhancementBypassed("stale"))
+                assertEquals(2,fakes.size)
+            } finally {controller.release()}
+        }
+    }
+}
