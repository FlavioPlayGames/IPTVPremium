+    vec2 uv = clamp((pixel + 0.5) / uInputSize, 0.5 / uInputSize, 1.0 - 0.5 / uInputSize);
+    return sqrt(clamp(texture2D(uTexSampler, uv).rgb, 0.0, 1.0));
+}
+float luma(vec3 c) { return c.b * 0.5 + c.r * 0.5 + c.g; }
+
+void main() {
+    vec2 p = floor(vTex * uInputSize);
+    vec3 b=sampleGamma(p+vec2(0.0,-1.0)), d=sampleGamma(p+vec2(-1.0,0.0));
+    vec3 e=sampleGamma(p), f=sampleGamma(p+vec2(1.0,0.0)), h=sampleGamma(p+vec2(0.0,1.0));
+    vec3 mn=min(min(b,d),min(f,h)), mx=max(max(b,d),max(f,h));
+    vec3 hitMin=min(mn,e)/max(4.0*mx,vec3(0.00001));
+    vec3 hitMax=(1.0-max(mx,e))/min(4.0*mn-4.0,vec3(-0.00001));
+    vec3 lobes=max(-hitMin,hitMax);
+    float lobe=max(-0.1875,min(max(lobes.r,max(lobes.g,lobes.b)),0.0))*uStrength;
+    float bL=luma(b),dL=luma(d),eL=luma(e),fL=luma(f),hL=luma(h);
+    float range=max(max(max(bL,dL),max(eL,fL)),hL)-min(min(min(bL,dL),min(eL,fL)),hL);
+    float noise=clamp(abs(0.25*(bL+dL+fL+hL)-eL)/max(range,0.00001),0.0,1.0);
+    lobe*=1.0-0.5*noise;
+    vec3 color=clamp((lobe*(b+d+f+h)+e)/(1.0+4.0*lobe),0.0,1.0);
+    gl_FragColor=vec4(color*color,1.0);
+}
