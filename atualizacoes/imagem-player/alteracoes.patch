+// Copyright (c) 2021 Advanced Micro Devices, Inc. MIT; see assets/FSR1-NOTICE.txt.
+precision highp float;
+uniform sampler2D uTexSampler;
+uniform vec2 uInputSize;
+uniform float uStrength;
+varying vec2 vTex;
+vec3 sampleGamma(vec2 pixel) {
+    vec2 uv = clamp((pixel + 0.5) / uInputSize, 0.5 / uInputSize, 1.0 - 0.5 / uInputSize);
+    return sqrt(clamp(texture2D(uTexSampler, uv).rgb, 0.0, 1.0));
+}
+float luma(vec3 c) { return c.b * 0.5 + c.r * 0.5 + c.g; }
+
+void tap(inout vec3 color,inout float weight,vec2 off,vec2 dir,vec2 len,float lob,float clipPoint,vec3 c) {
+    vec2 v=vec2(dot(off,dir),dot(off,vec2(-dir.y,dir.x)))*len;
+    float d2=min(dot(v,v),clipPoint);
+    float wb=0.4*d2-1.0, wa=lob*d2-1.0;
+    wb=1.5625*wb*wb-0.5625; wa*=wa;
+    float w=wb*wa; color+=c*w; weight+=w;
+}
+void edge(inout vec2 dir,inout float len,float weight,float a,float b,float c,float d,float e) {
+    float dx=d-b, dy=e-a;
+    dir+=vec2(dx,dy)*weight;
+    float lx=clamp(abs(dx)/max(max(abs(d-c),abs(c-b)),0.00001),0.0,1.0);
+    float ly=clamp(abs(dy)/max(max(abs(e-c),abs(c-a)),0.00001),0.0,1.0);
+    len+=(lx*lx+ly*ly)*weight;
+}
+void main() {
+    vec2 pixel=vTex*uInputSize-0.5, fp=floor(pixel), pp=fract(pixel);
+    vec3 b=sampleGamma(fp+vec2(0.0,-1.0)),c=sampleGamma(fp+vec2(1.0,-1.0));
+    vec3 e=sampleGamma(fp+vec2(-1.0,0.0)),f=sampleGamma(fp),g=sampleGamma(fp+vec2(1.0,0.0)),h=sampleGamma(fp+vec2(2.0,0.0));
+    vec3 i=sampleGamma(fp+vec2(-1.0,1.0)),j=sampleGamma(fp+vec2(0.0,1.0)),k=sampleGamma(fp+vec2(1.0,1.0)),l=sampleGamma(fp+vec2(2.0,1.0));
+    vec3 n=sampleGamma(fp+vec2(0.0,2.0)),o=sampleGamma(fp+vec2(1.0,2.0));
+    vec2 dir=vec2(0.0); float len=0.0;
+    edge(dir,len,(1.0-pp.x)*(1.0-pp.y),luma(b),luma(e),luma(f),luma(g),luma(j));
+    edge(dir,len,pp.x*(1.0-pp.y),luma(c),luma(f),luma(g),luma(h),luma(k));
+    edge(dir,len,(1.0-pp.x)*pp.y,luma(f),luma(i),luma(j),luma(k),luma(n));
+    edge(dir,len,pp.x*pp.y,luma(g),luma(j),luma(k),luma(l),luma(o));
+    float dirLength=dot(dir,dir);
+    dir=dirLength<0.000030517578125?vec2(1.0,0.0):dir*inversesqrt(dirLength);
+    len*=0.5; len*=len;
+    float stretch=dot(dir,dir)/max(max(abs(dir.x),abs(dir.y)),0.00001);
+    vec2 len2=vec2(1.0+(stretch-1.0)*len,1.0-0.5*len);
