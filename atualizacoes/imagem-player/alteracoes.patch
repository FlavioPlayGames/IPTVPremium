+package br.com.flaviotorres.iptvpremium.core.player
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.runtime.SideEffect
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.test.*
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.unit.dp
+import java.util.concurrent.atomic.AtomicInteger
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+
+class PlaybackImageButtonDeviceTest {
+    @get:Rule val compose = createComposeRule()
+    private fun checkButton(compact: Boolean) {
+        val image = AtomicInteger()
+        val settings = AtomicInteger()
+        lateinit var view: android.view.View
+        compose.setContent {
+            val local = LocalView.current
+            SideEffect { view = local }
+            Box(Modifier.width(520.dp).height(100.dp)) {
+                PlayerAuxiliaryButtons(Color(0xFFFFD54A), compact, true, true,
+                    onAudio = {}, onSubtitles = {}, onAspect = {},
+                    onImage = { image.incrementAndGet() }, onSettings = { settings.incrementAndGet() })
+            }
+        }
+        compose.onNodeWithText("Nitidez").assertExists()
+        compose.onNodeWithContentDescription("Nitidez e upscaling").assertHasClickAction().performClick()
+        assertEquals(1, image.get())
+        assertEquals(0, settings.get())
+        compose.onNodeWithContentDescription("Opções").performClick()
+        assertEquals(1, settings.get())
+        val imageBounds = compose.onNodeWithContentDescription("Nitidez e upscaling").fetchSemanticsNode().boundsInRoot
+        val menuBounds = compose.onNodeWithContentDescription("Opções").fetchSemanticsNode().boundsInRoot
+        assertTrue("The new front-row button must not overlap the menu", imageBounds.right <= menuBounds.left)
+
+    }
+    @Test fun compactPlayerHasADirectImageButtonBeforeTheMenu() = checkButton(true)
+    @Test fun widePlayerHasADirectImageButtonBeforeTheMenu() = checkButton(false)
+}
