+package br.com.flaviotorres.iptvpremium.core.player
+
+import android.content.Context
+import android.opengl.GLES20
+import androidx.media3.common.Effect
+import androidx.media3.common.VideoFrameProcessingException
+import androidx.media3.common.util.GlProgram
+import androidx.media3.common.util.GlUtil
+import androidx.media3.common.util.Size
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.effect.BaseGlShaderProgram
+import androidx.media3.effect.GlEffect
+import androidx.media3.effect.GlShaderProgram
+
+/** Frame-driven Media3 processing; it never schedules extra frames at the display refresh rate. */
+@androidx.annotation.OptIn(UnstableApi::class)
+internal object PlaybackImageEffects {
+    fun create(context: Context, value: PlaybackImageEnhancement, unsupported: (String) -> Unit): List<Effect> {
+        if (value.mode == PlaybackImageMode.OFF) return emptyList()
+        val metrics = context.resources.displayMetrics
+        val result = mutableListOf<Effect>()
+        if (value.mode == PlaybackImageMode.FSR1) result += StageEffect(context, true, value,
+            metrics.widthPixels, metrics.heightPixels, unsupported)
+        result += StageEffect(context, false, value, metrics.widthPixels, metrics.heightPixels, unsupported)
+        return result
+    }
+
+    private class StageEffect(val app: Context, val upscale: Boolean, val value: PlaybackImageEnhancement,
+                              val displayWidth: Int, val displayHeight: Int,
+                              val unsupported: (String) -> Unit) : GlEffect {
+        override fun toGlShaderProgram(context: Context, useHdr: Boolean): GlShaderProgram =
+            ImageProgram(app, upscale, value, displayWidth, displayHeight, useHdr, unsupported)
+        override fun isNoOp(inputWidth: Int, inputHeight: Int): Boolean = upscale &&
+            PlaybackImagePolicy.outputSize(inputWidth, inputHeight, displayWidth, displayHeight) == (inputWidth to inputHeight)
+    }
+
+    private class ImageProgram(context: Context, private val upscale: Boolean,
+                               private val value: PlaybackImageEnhancement,
+                               private val displayWidth: Int, private val displayHeight: Int,
+                               private val hdr: Boolean, private val unsupported: (String) -> Unit)
+        : BaseGlShaderProgram(hdr, 1) {
+        private val vertex = context.assets.open("shaders/image_vertex.glsl").bufferedReader().use { it.readText() }
+        private val copy = context.assets.open("shaders/image_copy.glsl").bufferedReader().use { it.readText() }
+        private var passthrough = hdr
+        private var program = GlProgram(vertex, if (hdr) copy else context.assets
+            .open(if (upscale) "shaders/image_easu.glsl" else "shaders/image_rcas.glsl")
+            .bufferedReader().use { it.readText() })
+
+        init {
+            if (hdr) unsupported("Melhoria desativada neste vídeo HDR/Dolby Vision.")
+            program.setBufferAttribute("aPosition", GlUtil.getNormalizedCoordinateBounds(), 4)
+        }
+        override fun configure(inputWidth: Int, inputHeight: Int): Size {
+            val reason = PlaybackImagePolicy.unsupported(value.mode, hdr, false, inputWidth, inputHeight)
+            if (reason != null) {
+                unsupported(reason)
+                if (!passthrough) {
+                    program.delete()
+                    program = GlProgram(vertex, copy)
+                    program.setBufferAttribute("aPosition", GlUtil.getNormalizedCoordinateBounds(), 4)
+                    passthrough = true
+                }
+            }
+            val size = if (upscale && !passthrough)
+                PlaybackImagePolicy.outputSize(inputWidth, inputHeight, displayWidth, displayHeight)
+                else inputWidth to inputHeight
+            program.setFloatsUniformIfPresent("uInputSize", floatArrayOf(inputWidth.toFloat(), inputHeight.toFloat()))
+            program.setFloatsUniformIfPresent("uStrength", floatArrayOf(value.strength.amount))
+            return Size(size.first, size.second)
+        }
+        override fun drawFrame(inputTexId: Int, presentationTimeUs: Long) {
+            try {
+                program.use()
+                program.setSamplerTexIdUniform("uTexSampler", inputTexId, 0)
+                program.bindAttributesAndUniforms()
+                // GlUtil bounds are ordered for a strip, not a perimeter fan.
+                GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4)
+                GlUtil.checkGlError()
+            } catch (error: GlUtil.GlException) {
+                throw VideoFrameProcessingException(error, presentationTimeUs)
+            }
+        }
+        override fun release() {
+            try { program.delete() } finally { super.release() }
+        }
+    }
+}
