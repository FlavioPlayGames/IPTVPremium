+    vec3 color=vec3(0.0);float weight=0.0;
+    tap(color,weight,vec2(0.0,-1.0)-pp,dir,len2,lob,clipPoint,b);
+    tap(color,weight,vec2(1.0,-1.0)-pp,dir,len2,lob,clipPoint,c);
+    tap(color,weight,vec2(-1.0,1.0)-pp,dir,len2,lob,clipPoint,i);
+    tap(color,weight,vec2(0.0,1.0)-pp,dir,len2,lob,clipPoint,j);
+    tap(color,weight,-pp,dir,len2,lob,clipPoint,f);
+    tap(color,weight,vec2(-1.0,0.0)-pp,dir,len2,lob,clipPoint,e);
+    tap(color,weight,vec2(1.0,1.0)-pp,dir,len2,lob,clipPoint,k);
+    tap(color,weight,vec2(2.0,1.0)-pp,dir,len2,lob,clipPoint,l);
+    tap(color,weight,vec2(2.0,0.0)-pp,dir,len2,lob,clipPoint,h);
+    tap(color,weight,vec2(1.0,0.0)-pp,dir,len2,lob,clipPoint,g);
+    tap(color,weight,vec2(1.0,2.0)-pp,dir,len2,lob,clipPoint,o);
+    tap(color,weight,vec2(0.0,2.0)-pp,dir,len2,lob,clipPoint,n);
+    vec3 lo=min(min(f,g),min(j,k)), hi=max(max(f,g),max(j,k));
+    color=clamp(color/max(weight,0.00001),lo,hi);
+    gl_FragColor=vec4(color*color,1.0);
