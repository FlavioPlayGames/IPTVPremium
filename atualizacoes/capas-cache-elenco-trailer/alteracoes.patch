+package br.com.flaviotorres.iptvpremium.core.storage
+
+import androidx.test.core.app.ApplicationProvider
+import android.content.Context
+import java.io.File
+import org.junit.Assert.*
+import org.junit.Test
+
+class RotatingPosterCacheDeviceTest {
+    @Test fun keepsTheCurrentWindowAndRotatesOlderFilesAtTheBudget() {
+        val root = File(ApplicationProvider.getApplicationContext<Context>().cacheDir, "rotation-${java.util.UUID.randomUUID()}")
+        val dir = File(root, "iptv_movie_posters_session").apply { mkdirs() }
+        val cache = ImageDiskBudget(root, maxBytes = 12)
+        fun image(name: String, time: Long): File = File(dir, "$name.img").apply {
+            writeBytes(ByteArray(6)); setLastModified(time)
+        }
+        try {
+            val current = image("current", 10_000)
+            val old = image("old", 20_000)
+            val next = image("next", 30_000)
+            cache.prefer(setOf(current.name, next.name))
+            assertEquals(6L, cache.maintain())
+            assertTrue(current.exists()); assertFalse(old.exists()); assertTrue(next.exists())
+            cache.prefer(emptySet())
+            val newer = image("newer", 40_000)
+            assertEquals(6L, cache.maintain())
+            assertFalse(current.exists()); assertTrue(next.exists()); assertTrue(newer.exists())
+            assertEquals(12L, dir.listFiles()!!.sumOf { it.length() })
+        } finally { root.deleteRecursively() }
+    }
+    @Test fun neverDeletesAnImageBeingDecoded() {
+        val root = File(ApplicationProvider.getApplicationContext<Context>().cacheDir, "rotation-${java.util.UUID.randomUUID()}")
+        val dir = File(root, "iptv_movie_posters_session").apply { mkdirs() }
+        val cache = ImageDiskBudget(root, maxBytes = 6)
+        val active = File(dir, "active.img").apply { writeBytes(ByteArray(6)); setLastModified(10_000) }
+        try {
+            cache.retain(active).use {
+                File(dir, "other.img").writeBytes(ByteArray(6))
+                cache.maintain()
+                assertTrue(active.exists())
+            }
+        } finally { root.deleteRecursively() }
+    }
+}
