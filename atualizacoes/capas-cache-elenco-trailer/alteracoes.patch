+package br.com.flaviotorres.iptvpremium.data.repository
+
+import android.content.Context
+import android.graphics.Bitmap
+import androidx.test.core.app.ApplicationProvider
+import br.com.flaviotorres.iptvpremium.ui.movies.preloadMovieDetailsImages
+import br.com.flaviotorres.iptvpremium.ui.movies.MovieDetailsImageLoader
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.ConcurrentLinkedQueue
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class MovieOpeningImagesDeviceTest {
+    @Test fun openingWaitsForCastAfterBothPrincipalImages() = runBlocking {
+        val server = ServerSocket(0)
+        val clients = ConcurrentLinkedQueue<Socket>()
+        val paths = ConcurrentLinkedQueue<String>()
+        val primary = CountDownLatch(2)
+        val artist = CountDownLatch(1)
+        val releasePrimary = CountDownLatch(1)
+        val releaseArtist = CountDownLatch(1)
+        val image = java.io.ByteArrayOutputStream().also { out ->
+            Bitmap.createBitmap(16, 24, Bitmap.Config.ARGB_8888).apply { eraseColor(android.graphics.Color.BLUE) }
+                .compress(Bitmap.CompressFormat.PNG, 100, out)
+        }.toByteArray()
+        kotlin.concurrent.thread(isDaemon = true) {
+            try { while (!server.isClosed) {
+                val client = server.accept(); clients.add(client)
+                kotlin.concurrent.thread(isDaemon = true) {
+                    try { client.use {
+                        val reader = it.getInputStream().bufferedReader()
+                        val path = reader.readLine().split(' ')[1]
+                        while (!reader.readLine().isNullOrEmpty()) { }
+                        paths.add(path)
+                        if (path == "/artist.png") { artist.countDown(); releaseArtist.await(5, TimeUnit.SECONDS) }
+                        else { primary.countDown(); releasePrimary.await(5, TimeUnit.SECONDS) }
+                        it.getOutputStream().apply {
+                            write("HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: ${image.size}\r\nConnection: close\r\n\r\n".toByteArray())
+                            write(image); flush()
+                        }
+                    } } catch (_: Exception) { }
+                }
+            } } catch (_: Exception) { }
+        }
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        val base = "http://127.0.0.1:${server.localPort}"
+        val opening = async(Dispatchers.Default) {
+            preloadMovieDetailsImages(context, "$base/backdrop.png", "$base/logo.png", 960, 540,
+                castProfileUrls = listOf("$base/artist.png"), primaryTimeoutMs = 4_000)
+        }
+        try {
+            assertTrue(primary.await(3, TimeUnit.SECONDS))
+            assertFalse(paths.contains("/artist.png"))
+            releasePrimary.countDown()
+            assertTrue(artist.await(3, TimeUnit.SECONDS))
+            assertFalse("Opening must still wait for the artist photo", opening.isCompleted)
+            releaseArtist.countDown()
+            val result = withTimeout(4_000) { opening.await() }
+            assertTrue(result.backdropReady)
+            assertTrue(result.titleLogoReady)
+            assertEquals(1, result.castPhotosRequested)
+            assertEquals(1, result.castPhotosReady)
+            val density = context.resources.displayMetrics.density
+            val compact = 540 / density < 500 || 960 / density < 800
+            assertNotNull(MovieDetailsImageLoader.peekFromMemory(context, "$base/artist.png",
+                kotlin.math.round((if (compact) 96 else 108) * density).toInt(),
+                kotlin.math.round((if (compact) 132 else 148) * density).toInt()))
+        } finally {
+            releasePrimary.countDown(); releaseArtist.countDown()
+            opening.cancel(); server.close(); clients.forEach { runCatching { it.close() } }
+        }
+    }
+}
