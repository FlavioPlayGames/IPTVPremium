+package br.com.flaviotorres.iptvpremium.data.cache
+
+/** Optimize only the official TMDB image service; provider URLs and cache keys stay intact. */
+internal fun catalogPosterDownloadUrl(url: String): String {
+    val uri = runCatching { java.net.URI(url) }.getOrNull() ?: return url
+    if (!uri.host.orEmpty().equals("image.tmdb.org", ignoreCase = true)) return url
+    val parts = uri.rawPath.orEmpty().split('/')
+    if (parts.size != 5 || parts[1] != "t" || parts[2] != "p" || parts[4].isBlank()) return url
+    val size = parts[3]
+    if (size != "original" && (size.removePrefix("w").toIntOrNull() ?: 0) <= 500) return url
+    val start = url.indexOf("/t/p/") + 5
+    return url.replaceRange(start, start + size.length, "w500")
+}
+
+internal fun catalogPosterBitmapSize(width: Int, height: Int): Pair<Int, Int> {
+    require(width > 0 && height > 0)
+    val scale = minOf(1.0, 512.0 / width, 768.0 / height)
+    return (width * scale).toInt().coerceAtLeast(1) to (height * scale).toInt().coerceAtLeast(1)
+}
