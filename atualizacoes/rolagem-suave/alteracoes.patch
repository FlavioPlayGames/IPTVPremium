+@OptIn(ExperimentalTestApi::class)
+class CatalogSmoothScrollDeviceTest {
+    @get:Rule val compose = createComposeRule()
+    private lateinit var grid: LazyGridState
+    private val focused = AtomicInteger(-1)
+    private fun setup(columns: Int) {
+        compose.setContent {
+            grid = rememberLazyGridState()
+            val scope = rememberCoroutineScope()
+            val navigator = remember { CatalogGridNavigator(grid, scope, columns, { 200 }, {}, {}) }
+            DisposableEffect(navigator) { onDispose { navigator.cancel() } }
+            LazyVerticalGrid(GridCells.Fixed(columns), Modifier.width(600.dp).height(226.dp)
+                .catalogGridHost(navigator).testTag("smooth-grid"), grid,
+                contentPadding = PaddingValues(8.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                items(200, key = { it }) { index ->
+                    val requester = remember { FocusRequester() }
+                    BindCatalogFocus(navigator, index, requester)
+                    LaunchedEffect(index) {
+                        if (index == 2 && focused.get() < 0) { withFrameNanos {}; requester.requestFocus() }
+                    }
+                    Box(Modifier.height(100.dp).testTag("smooth-$index").focusRequester(requester)
+                        .catalogGridNavigation(navigator, index, requester)
+                        .onFocusChanged { if (it.isFocused) { focused.set(index); navigator.focused(index) } }
+                        .focusable())
+                }
+            }
+        }
+        compose.waitUntil(5_000) { focused.get() == 2 }
+    }
+    private fun position(columns: Int): Float = compose.runOnIdle {
+        val item = grid.layoutInfo.visibleItemsInfo.first()
+        val step = item.size.height + grid.layoutInfo.mainAxisItemSpacing
+        (grid.firstVisibleItemIndex / columns * step + grid.firstVisibleItemScrollOffset).toFloat()
+    }
+    private fun assertTwoRows(columns: Int) = compose.runOnIdle {
+        val layout = grid.layoutInfo
+        val full = layout.visibleItemsInfo.count {
+            it.offset.y >= layout.viewportStartOffset && it.offset.y + it.size.height <= layout.viewportEndOffset
+        }
+        assertEquals(columns * 2, full)
+        assertEquals(0, grid.firstVisibleItemScrollOffset)
+    }
+    private fun rowSlides(columns: Int) {
+        setup(columns)
+        compose.mainClock.autoAdvance = false
+        compose.onNodeWithTag("smooth-2").performKeyInput { pressKey(Key.DirectionDown); pressKey(Key.DirectionDown) }
+        compose.mainClock.advanceTimeBy(64)
+        val step = compose.runOnIdle { grid.layoutInfo.visibleItemsInfo.first().size.height + grid.layoutInfo.mainAxisItemSpacing }
+        val middle = position(columns)
+        assertTrue("An intermediate frame must move without jumping the whole row: $middle", middle > 0f && middle < step)
+        compose.mainClock.advanceTimeBy(700)
+        compose.onNodeWithTag("smooth-${2 + columns * 2}").assertIsFocused()
+        assertEquals(columns, compose.runOnIdle { grid.firstVisibleItemIndex })
+        assertTwoRows(columns)
+    }
+    private fun repeatAndReverse(columns: Int) {
+        setup(columns)
+        compose.mainClock.autoAdvance = false
+        compose.onNodeWithTag("smooth-2").performKeyInput { repeat(12) { pressKey(Key.DirectionDown) } }
+        compose.mainClock.advanceTimeBy(64)
+        val before = position(columns)
+        assertTrue(before > 0f)
+        compose.onNodeWithTag("smooth-grid").performKeyInput { repeat(12) { pressKey(Key.DirectionUp) } }
+        compose.mainClock.advanceTimeBy(16)
+        assertTrue("Retargeting must not snap to the first row", position(columns) > 0f)
+        compose.mainClock.advanceTimeBy(900)
+        compose.onNodeWithTag("smooth-2").assertIsFocused()
+        assertEquals(0f, position(columns), 1f)
+        assertTwoRows(columns)
+    }
+    @Test fun fourColumnsSlideAndSettleWithEightCards() = rowSlides(4)
+    @Test fun fiveColumnsSlideAndSettleWithTenCards() = rowSlides(5)
+    @Test fun fourColumnsRetargetRepeatedArrowsWithoutJumping() = repeatAndReverse(4)
+    @Test fun fiveColumnsRetargetRepeatedArrowsWithoutJumping() = repeatAndReverse(5)
+}
