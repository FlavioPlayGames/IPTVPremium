+package br.com.flaviotorres.iptvpremium.data.cache
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Color
+import java.io.File
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+
+@org.junit.runner.RunWith(androidx.test.ext.junit.runners.AndroidJUnit4::class)
+class PosterCompactDeviceTest {
+    private fun image(format: Bitmap.CompressFormat, alpha: Boolean):File {
+        val file=File.createTempFile("compact-poster", ".img")
+        val bitmap=Bitmap.createBitmap(780,1170,Bitmap.Config.ARGB_8888)
+        bitmap.eraseColor(if(alpha)Color.argb(100,20,40,60) else Color.BLUE)
+        bitmap.setHasAlpha(alpha)
+        try { file.outputStream().use { bitmap.compress(format,90,it) } }
+        finally { bitmap.recycle() }
+        return file
+    }
+    @Test fun opaqueJpegUses565AndRealAllocationIsHalf() {
+        val file=image(Bitmap.CompressFormat.JPEG,false)
+        try {
+            val compact=PosterResolution.decode(file,Bitmap.Config.RGB_565)!!
+            val full=PosterResolution.decode(file,Bitmap.Config.ARGB_8888)!!
+            assertEquals(300,compact.width);assertEquals(450,compact.height)
+            assertEquals(Bitmap.Config.RGB_565,compact.config)
+            assertEquals(full.allocationByteCount/2,compact.allocationByteCount)
+            compact.recycle();full.recycle()
+        } finally { file.delete() }
+    }
+    @Test fun transparentPngKeepsAlphaInRamAndAfterDiskReduction():Unit=runBlocking {
+        val file=image(Bitmap.CompressFormat.PNG,true)
+        try {
+            assertTrue(PosterResolution.prepareDownloaded(file,1_000_000))
+            val bitmap=PosterResolution.decode(file,Bitmap.Config.RGB_565)!!
+            assertEquals(Bitmap.Config.ARGB_8888,bitmap.config)
+            assertTrue(bitmap.hasAlpha());assertTrue(Color.alpha(bitmap.getPixel(0,0)) in 90..110)
+            assertEquals(300,bitmap.width);assertEquals(450,bitmap.height);bitmap.recycle()
+            assertEquals("image/png",BitmapFactory.Options().apply {inJustDecodeBounds=true;BitmapFactory.decodeFile(file.path,this)}.outMimeType)
+        } finally { file.delete() }
+    }
+}
