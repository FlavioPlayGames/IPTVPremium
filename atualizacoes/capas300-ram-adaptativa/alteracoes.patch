+package br.com.flaviotorres.iptvpremium.data.cache
+
+import android.app.ActivityManager
+import android.content.Context
+
+internal data class ImageRamBudget(val postersMb: Int, val detailsMb: Int, val carouselMb: Int) {
+    val totalMb get() = postersMb + detailsMb + carouselMb
+}
+
+/** Orcamento dos tres caches juntos; memoryClass e heap, nunca um limite de PSS. */
+internal object ImageRamPolicy {
+    @Volatile private var configured: ImageRamBudget? = null
+    @Volatile private var signalUntil = 0L
+
+    fun calculate(heapMb: Int, lowRam: Boolean): ImageRamBudget {
+        val total = (heapMb.coerceAtLeast(16) / 5).coerceIn(3, if (lowRam) 24 else 56)
+        val posters = (total * 5 / 12).coerceIn(1, 20)
+        val details = (total * 5 / 12).coerceIn(1, 24)
+        val carousel = (total - posters - details).coerceIn(1, 12)
+        return ImageRamBudget(posters, details, carousel)
+    }
+
+    fun forContext(context: Context): ImageRamBudget = configured ?: synchronized(this) {
+        configured ?: run {
+            val manager = context.applicationContext.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+            val heap = (Runtime.getRuntime().maxMemory() / (1024 * 1024)).coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
+            val info = ActivityManager.MemoryInfo()
+            manager?.getMemoryInfo(info)
+            val low = manager?.isLowRamDevice == true || (info.totalMem in 1..1_610_612_736L)
+            calculate(minOf(heap, manager?.memoryClass ?: heap), low).also { configured = it }
+        }
+    }
+
+    /** Fracao do limite que permanece; ocultar o app nao esvazia os caches. */
+    fun retainedFraction(level: Int): Float = when {
+        level >= 80 -> 0f
+        level >= 60 -> .25f
+        level >= 40 -> .5f
+        level == 20 -> .75f
+        level >= 15 -> .25f
+        level >= 10 -> .5f
+        level >= 5 -> .75f
+        else -> 1f
+    }
+
+    fun signal(level: Int) {
+        if (level >= 5 && level != 20) signalUntil = android.os.SystemClock.elapsedRealtime() + 15_000L
+    }
+
+    fun heapPressure(previous: Boolean, used: Long, maximum: Long, systemLow: Boolean): Boolean =
+        systemLow || (maximum > 0 && used.toDouble() / maximum >= if (previous) .65 else .80)
+
+    fun pressured(context: Context, previous: Boolean): Boolean {
+        val manager = context.applicationContext.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+        val info = ActivityManager.MemoryInfo(); manager?.getMemoryInfo(info)
+        val runtime = Runtime.getRuntime()
+        return android.os.SystemClock.elapsedRealtime() < signalUntil ||
+            heapPressure(previous, runtime.totalMemory() - runtime.freeMemory(), runtime.maxMemory(), info.lowMemory)
+    }
+}
