+package br.com.flaviotorres.iptvpremium.data.cache
+
+/** Apenas hashes, nunca enderecos, credenciais ou conteudo da lista. */
+internal object RecentPosterKeys {
+    private val key = Regex("[a-f0-9]{64}")
+    fun decode(text: String): List<String> =
+        if (text.length > 1024) emptyList() else text.lineSequence().filter { key.matches(it) }.distinct().take(5).toList()
+    fun encode(keys: List<String>): String = keys.filter { key.matches(it) }.distinct().take(5).joinToString("\n")
+}
