+package br.com.flaviotorres.iptvpremium.ui.movies
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MovieOpeningPolicyTest {
+    @Test fun finalAnimationFitsInsideThreeSecondPresentation() {
+        assertEquals(3_000L, MovieOpeningPolicy.spinBudgetMs + MovieOpeningPolicy.finishingMs)
+        assertTrue(MovieOpeningPolicy.spinBudgetMs > 0)
+        assertEquals(0L, MovieOpeningPolicy.minimumWaitMs(0, true))
+        assertEquals(0L, MovieOpeningPolicy.minimumWaitMs(0, false))
+    }
+    @Test fun spinStartsAtRestAndAcceleratesGradually() {
+        assertEquals(0f, MovieOpeningPolicy.spinDistance(0f), 0f)
+        assertEquals(0f, MovieOpeningPolicy.spinVelocity(0f), 0f)
+        assertTrue(MovieOpeningPolicy.spinVelocity(.1f) < MovieOpeningPolicy.spinVelocity(.3f))
+        assertEquals(MovieOpeningPolicy.rotationSpeed, MovieOpeningPolicy.spinVelocity(1f), .001f)
+        assertTrue(MovieOpeningPolicy.spinDistance(1.4f) < 1f)
+    }
+    @Test fun chosenCoverDoesNotRequireAnotherFullOrbit() {
+        for (count in listOf(1f, 4f, 8f, 20f)) {
+            for (step in 0..100) {
+                val position = step * .37f
+                val delta = MovieOpeningPolicy.alignmentDelta(position, 0f, count)
+                assertTrue(kotlin.math.abs(delta) <= count / 2f + .001f)
+                if (count > 1f) {
+                    val residual = ((position + delta) % count + count) % count
+                    assertTrue(residual < .001f || count - residual < .001f)
+                }
+            }
+        }
+        assertEquals(-.8f, MovieOpeningPolicy.alignmentDelta(.8f, 0f, 20f), .001f)
+    }
+    @Test fun alignmentPreservesEntryVelocityAndStopsExactlyOnChosenCover() {
+        val initial = .8f
+        val duration = MovieOpeningPolicy.alignNanos / 1_000_000_000f
+        fun sample(t: Float) = MovieOpeningPolicy.alignmentPosition(initial, 0f, .8f, t)
+        assertEquals(initial, sample(0f), 0f)
+        assertEquals(0f, sample(1f), .00001f)
+        assertEquals(.8f, (sample(.001f) - sample(0f)) / (.001f * duration), .02f)
+        assertEquals(0f, (sample(1f) - sample(.999f)) / (.001f * duration), .02f)
+    }
+}
