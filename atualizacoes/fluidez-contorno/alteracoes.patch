+package br.com.flaviotorres.iptvpremium.ui.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithCache
+import androidx.compose.ui.geometry.CornerRadius
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.dp
+import br.com.flaviotorres.iptvpremium.ui.theme.ThemeColors
+
+/** Draw-phase fallback: no screen recomposition or extra bitmap while a row slides in. */
+@Composable
+internal fun Modifier.catalogMovingOutline(navigator: CatalogGridNavigator): Modifier {
+    val posterWidth = with(LocalDensity.current) { LocalCatalogPosterWidth.current.toPx() }
+    return drawWithCache {
+        val accent = ThemeColors.tone(1f, 1f)
+        val reflection = ThemeColors.tone(1f, .55f)
+        val rim = Brush.linearGradient(listOf(reflection, accent, reflection, accent))
+        val outer = Stroke(2.dp.toPx())
+        val separator = Stroke(1.dp.toPx())
+        val inner = Stroke(.7.dp.toPx())
+        val gap = 1.6.dp.toPx()
+        val inset = 2.5.dp.toPx()
+        val radius = CATALOG_POSTER_CORNER_DP.dp.toPx()
+        onDrawWithContent {
+            drawContent()
+            navigator.movingOutline(posterWidth, size.height)?.let { rect ->
+                drawRoundRect(rim, rect.topLeft, rect.size, CornerRadius(radius), style = outer)
+                drawRoundRect(Color(0xB3000000), rect.topLeft + Offset(gap, gap),
+                    Size((rect.width - 2 * gap).coerceAtLeast(0f), (rect.height - 2 * gap).coerceAtLeast(0f)),
+                    CornerRadius((radius - gap).coerceAtLeast(0f)), style = separator)
+                drawRoundRect(rim, rect.topLeft + Offset(inset, inset),
+                    Size((rect.width - 2 * inset).coerceAtLeast(0f), (rect.height - 2 * inset).coerceAtLeast(0f)),
+                    CornerRadius((radius - inset).coerceAtLeast(0f)), style = inner)
+            }
+        }
+    }
+}
