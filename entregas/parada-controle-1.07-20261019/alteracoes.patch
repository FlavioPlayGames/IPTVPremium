+    private fun heldRelease(columns: Int) {
+        setup(columns, true)
+        compose.mainClock.autoAdvance = false
+        fun send(action: Int, repeat: Int) = compose.runOnIdle {
+            val native = android.view.KeyEvent(0L, 0L, action, android.view.KeyEvent.KEYCODE_DPAD_DOWN, repeat)
+            navigation.key(2, androidx.compose.ui.input.key.KeyEvent(native))
+        }
+        send(android.view.KeyEvent.ACTION_DOWN, 0)
+        repeat(24) { repeat ->
+            send(android.view.KeyEvent.ACTION_DOWN, repeat + 1)
+            compose.mainClock.advanceTimeBy(32)
+        }
+        val before = position(columns)
+        val step = compose.runOnIdle { grid.layoutInfo.visibleItemsInfo.first().size.height + grid.layoutInfo.mainAxisItemSpacing }
+        send(android.view.KeyEvent.ACTION_UP, 0)
+        compose.mainClock.advanceTimeBy(700)
+        val after = position(columns)
+        assertTrue("Release must settle near the visible screen: before=$before after=$after", kotlin.math.abs(after - before) <= step / 2f + 2f)
+        assertEquals(2, focused.get() % columns)
+        compose.onNodeWithTag("smooth-${focused.get()}").assertIsFocused()
+        assertTwoRows(columns)
+    }
