// Configuracao reconstruida com base nas capturas fornecidas.
// Banco existente; sem comandos de criacao ou migracao.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "central-iptv-premium",
  "main": "worker-atualizacao-abi.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "centraliptvpremium.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "central-iptv-premium",
      "database_id": "a00e82d6-a8d8-4f43-a53b-861f4ac73a8f"
    }
  ]
}
