+    /** One network read, bounded buffers, private files; never hold the playlist in RAM. */
+    suspend fun downloadSections(url: String, directory: java.io.File): Map<br.com.flaviotorres.iptvpremium.data.sync.CatalogSection, java.io.File> {
+        check(directory.mkdirs() || directory.isDirectory)
+        val files = br.com.flaviotorres.iptvpremium.data.sync.CatalogSection.entries.associateWith {
+            java.io.File(directory, it.name + ".m3u")
+        }
+        val writers = files.mapValues { (_, file) -> file.bufferedWriter() }
+        var pending: String? = null
+        var entries = 0L
+        var characters = 0L
+        try {
+            httpClient.readLines(url) { raw ->
+                currentCoroutineContext().ensureActive()
+                characters += raw.length
+                check(characters <= 512L * 1024 * 1024) { "A lista excede o espaço reservado para importação." }
+                val line = raw.removePrefix("\uFEFF").trim()
+                if (line.startsWith("#EXTINF", true)) pending = line
+                else if (line.isNotBlank() && !line.startsWith("#")) {
+                    val info = pending
+                    pending = null
+                    if (info != null) {
+                        val group = extractAttribute(info, "group-title").orEmpty()
+                        val kind = when (classifyEntry(line, group, extractDisplayName(info))) {
+                            EntryType.LIVE_TV -> br.com.flaviotorres.iptvpremium.data.sync.CatalogSection.LIVE_TV
+                            EntryType.MOVIE -> br.com.flaviotorres.iptvpremium.data.sync.CatalogSection.MOVIES
+                            EntryType.SERIES -> br.com.flaviotorres.iptvpremium.data.sync.CatalogSection.SERIES
+                        }
+                        writers.getValue(kind).apply { write(info); newLine(); write(line); newLine() }
+                        entries++
+                    }
+                }
+            }
+            check(entries > 0) { "O endereço informado não retornou uma lista M3U válida." }
+            return files
+        } finally { writers.values.forEach { it.close() } }
+    }
