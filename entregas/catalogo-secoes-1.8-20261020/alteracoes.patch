+    @Test fun publicationConflictRollsBackCategoriesAndKeepsSectionPending() = fixture { f ->
+        val parent = f.manager.prepareSectionShell(source.id)
+        val stage = f.manager.beginImport(source.id)
+        val writer = XtreamCatalogWriter(f.dao, f.manager, source.id, parent)
+        val movie = Movie("duplicate", "Movie", null, null, null, "https://example.invalid/movie.mp4", null, null, null)
+        writer.append("get_vod_streams", PlaylistContent(movies = listOf(movie)))
+        val stageWriter = XtreamCatalogWriter(f.dao, f.manager, source.id, stage)
+        stageWriter.append("get_vod_streams", PlaylistContent(movies = listOf(movie), categories = listOf(
+            Category("category", "Movies", CategoryType.MOVIES, CategorySource.PROVIDER))))
+        try { f.dao.publishSection(source.id, stage, parent, "MOVIES"); fail() }
+        catch (_: android.database.sqlite.SQLiteConstraintException) { }
+        assertEquals(3, f.dao.pendingSections(source.id, parent).size)
+        assertTrue(f.dao.getCategoriesByType(source.id, parent, "MOVIES").isEmpty())
+        assertEquals(1, f.dao.getCategoriesByType(source.id, stage, "MOVIES").size)
+        assertEquals(1, f.dao.getMovieCount(source.id, stage))
+        assertEquals(1, f.dao.getMovieCount(source.id, parent))
+        f.manager.discardImport(source.id, stage)
+    }
+    @Test fun migrationPreservesExistingActiveCatalog() = runBlocking {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        val name = "section-migration-" + UUID.randomUUID() + ".db"
+        var db = Room.databaseBuilder(context, PlaylistCacheDatabase::class.java, name).build()
+        try {
+            val manager = PlaylistCacheGenerationManager(db.playlistCacheDao())
+            val gen = manager.beginImport(source.id)
+            manager.markImportReady(source.id, gen)
+            manager.activateReadyGenerationOnStartup(source.id)
+            db.openHelper.writableDatabase.execSQL("DROP TABLE cached_sections")
+            db.openHelper.writableDatabase.execSQL("PRAGMA user_version=4")
+            db.close()
+            db = Room.databaseBuilder(context, PlaylistCacheDatabase::class.java, name).addMigrations(PlaylistCacheDatabase.MIGRATION_4_5).build()
+            assertEquals(gen, db.playlistCacheDao().getActiveGeneration(source.id)?.generationId)
+            assertTrue(db.playlistCacheDao().pendingSections(source.id, gen).isEmpty())
+        } finally { db.close(); context.deleteDatabase(name) }
+    }
