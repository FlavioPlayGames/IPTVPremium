+        if(source==null){Text("Selecione uma lista com catálogo disponível para escolher o conteúdo.",color=SettingsLook.text);return@SubtitleSettingsFrame}
+        when {
+            kind==null->Column(verticalArrangement=Arrangement.spacedBy(14.dp)) {
+                MarbleSettingsButton("Filme",modifier=Modifier.focusRequester(first)){kind="movie"}
